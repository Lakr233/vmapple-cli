+/// 13.6 and 14.6.1 are believed by their own strings, each with its own
+/// `IOSurface`: the surface descriptor is the one the `IOSurface` at `+0x20`
+/// keeps (13.6 at `+0x38`, with another descriptor at `+0x30` to be passed
+/// over), and its drop is found and condemned as on 27.2. The table's drop is
+/// found at `+0x48`.
+#[test]
+fn the_13_6_and_14_6_1_kernels_read_the_surface_through_its_iosurface() {
+    for (macos, version, layout) in [
+        ("13.6", KERNEL_VERSION_13_6, UNSHIFTED_13_6),
+        ("14.6.1", KERNEL_VERSION_14_6_1, UNSHIFTED_14_6_1),
+    ] {
+        with_switches(true, true, || {
+            let (mut state, mut host) = laid_out(version, layout);
+            if layout == UNSHIFTED_13_6 {
+                put64(&mut host, IOSURFACE + 0x30, OTHER_IOMD);
+            }
+            let cap = crate::observe::FailCapture::start();
+            on_map(&mut state, &host, MID);
+            let kernel = lines_with(&cap, "wire_watch_kernel verified");
+            assert_eq!(kernel.len(), 1, "{macos}: {:?}", cap.lines());
+            assert!(
+                kernel[0].contains(&format!("version=\"{version}\""))
+                    && kernel[0].contains(&format!("macos={macos} layout=unshifted")),
+                "{}",
+                kernel[0]
+            );
+            let map = lines_with(&cap, "wire_watch map mapping=2 ");
+            assert_eq!(map.len(), 1, "{macos}: {:?}", cap.lines());
+            assert!(
+                map[0].contains(&format!(
+                    "surface_iomd={SURFACE:#x} table_iomd={TABLE:#x} surface_wire=1 table_wire=2"
+                )) && map[0].contains("pages=3 ")
+                    && map[0].contains("at=map")
+                    && map[0].ends_with(&format!("iosurface={IOSURFACE:#x}")),
+                "{}",
+                map[0]
+            );
+            assert!(write_now(
+                &mut state,
+                &host,
+                MID,
+                "mapping_write",
+                WriteKind::Cpu
+            ));
+            put32(&mut host, TABLE + IOMD_WIRE_COUNT, 1);
+            set_surface_wire(&mut host, 0);
+            assert!(!write_now(
+                &mut state,
+                &host,
+                MID,
+                "mapping_write",
+                WriteKind::Cpu
+            ));
+            assert!(
+                cap.one("wire_guard_condemned")
+                    .contains("mapping=2 field=surface"),
+                "{macos}"
+            );
+            let anomalies = lines_with(&cap, "wire_watch first_anomaly ");
+            assert_eq!(anomalies.len(), 2, "{macos}: {:?}", cap.lines());
+            assert!(
+                anomalies[0].contains(&format!("field=surface value=0 map=1 iomd={SURFACE:#x}"))
+            );
+            assert!(anomalies[1].contains(&format!("field=table value=1 map=2 iomd={TABLE:#x}")));
+        });
+    }
+}
