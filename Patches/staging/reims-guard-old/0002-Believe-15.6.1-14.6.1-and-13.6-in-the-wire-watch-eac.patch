+/// 15.6.1 runs 27.2's driver at every offset read here: believed by its own
+/// string, read with the shifted layout, and guarded the same way.
+#[test]
+fn the_15_6_1_kernel_is_believed_with_the_shifted_layout() {
+    with_switches(true, true, || {
+        let (mut state, mut host) = fixture(KERNEL_VERSION_15_6_1);
+        let cap = crate::observe::FailCapture::start();
+        on_map(&mut state, &host, MID);
+        let kernel = lines_with(&cap, "wire_watch_kernel verified");
+        assert_eq!(kernel.len(), 1, "{:?}", cap.lines());
+        assert!(
+            kernel[0].contains(&format!("version=\"{KERNEL_VERSION_15_6_1}\""))
+                && kernel[0].contains("macos=15.6.1 layout=shifted"),
+            "{}",
+            kernel[0]
+        );
+        let map = lines_with(&cap, "wire_watch map mapping=2 ");
+        assert_eq!(map.len(), 1, "{:?}", cap.lines());
+        assert!(
+            map[0].contains(&format!(
+                "surface_iomd={SURFACE:#x} table_iomd={TABLE:#x} surface_wire=1 table_wire=2"
+            )) && map[0].contains("iosurface=-"),
+            "{}",
+            map[0]
+        );
+        set_surface_wire(&mut host, 0);
+        assert!(!write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+        assert!(cap
+            .one("wire_guard_condemned")
+            .contains("mapping=2 field=surface"));
+    });
+}
