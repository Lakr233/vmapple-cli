+fn read_chain<H: HostMemory + HostOps>(
+    rd: &Reader<'_, H>,
+    layout: &Layout,
+    internal: u64,
+) -> Option<Chain> {
+    let mi = read_mi(rd, layout, internal)?;
+    let (iosurface, surface_iomd) = match layout.surface {
+        SurfaceAt::Descriptor => (None, mi.object),
+        SurfaceAt::IoSurface { descriptor, .. } => {
+            let mut s = IoSurfaceFields::default();
+            if guest_kernel_va(mi.object) {
+                let mut b = vec![0u8; descriptor as usize + 8];
+                if !rd.bytes(mi.object, &mut b) {
+                    return None;
+                }
+                let u64_at = |o: usize| u64::from_le_bytes(b[o..o + 8].try_into().unwrap());
+                s = IoSurfaceFields {
+                    vtable: u64_at(0),
+                    descriptor: u64_at(descriptor as usize),
+                };
+            }
+            (Some(s), s.descriptor)
+        }
+    };
+    let iomd = |at: u64| {
+        if guest_kernel_va(at) {
+            read_iomd(rd, at)
+        } else {
+            Some(IomdFields::default())
+        }
+    };
+    Some(Chain {
+        mi,
+        iosurface,
+        surface_iomd,
+        surface: iomd(surface_iomd)?,
+        table: iomd(mi.table)?,
+    })
+}
+
+/// What two reads of a chain say.
+enum Sandwich {
+    /// Both reads named the same objects; the counts are the first read's,
+    /// which lie between the two.
+    Same(Chain),
+    /// Something in the chain named another object at the second read than
+    /// at the first. Nothing is concluded; it is read again later.
+    Moved(&'static str),
+    /// A read failed. Nothing is concluded either.
+    Unreadable,
+}
+
+/// The chain read twice. Only a chain both reads agree on is ever checked or
+/// compared, so a count is never taken from an object swapped in mid-read.
+fn read_sandwich<H: HostMemory + HostOps>(
+    rd: &Reader<'_, H>,
+    layout: &Layout,
+    internal: u64,
+) -> Sandwich {
+    let (Some(first), Some(second)) = (
+        read_chain(rd, layout, internal),
+        read_chain(rd, layout, internal),
+    ) else {
+        return Sandwich::Unreadable;
+    };
+    match first.moved_from(&second) {
+        Some(link) => Sandwich::Moved(link),
+        None => Sandwich::Same(first),
+    }
+}
