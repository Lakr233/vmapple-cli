+/// `+0x58` and `+0x60` are no reserved zeros on the unshifted layout: they
+/// hold the eviction deadline `MappingInternal::complete` arms and the flag a
+/// page table of two or more pages sets. Non-zero at `MAP` they are passed
+/// over, and moving between samples they move nothing.
+#[test]
+fn an_unshifted_deadline_and_table_flag_are_not_reserved_zeros() {
+    for layout in [UNSHIFTED_13_6, UNSHIFTED_14_6_1] {
+        with_switches(true, true, || {
+            let version = if layout == UNSHIFTED_13_6 {
+                KERNEL_VERSION_13_6
+            } else {
+                KERNEL_VERSION_14_6_1
+            };
+            let (mut state, mut host) = laid_out(version, layout);
+            put64(&mut host, MI + DEADLINE, 0x0000_0456_7890_abcd);
+            put64(&mut host, MI + TWO_TABLE_PAGES, 1);
+            let cap = crate::observe::FailCapture::start();
+            on_map(&mut state, &host, MID);
+            assert_eq!(
+                lines_with(&cap, "wire_watch map mapping=2 ").len(),
+                1,
+                "{:?}",
+                cap.lines()
+            );
+            for (deadline, flag) in [
+                (0x0000_0456_7891_0000u64, 1u64),
+                (0, 0),
+                (0x0000_0456_7899_0000, 1),
+            ] {
+                put64(&mut host, MI + DEADLINE, deadline);
+                put64(&mut host, MI + TWO_TABLE_PAGES, flag);
+                assert!(write_now(
+                    &mut state,
+                    &host,
+                    MID,
+                    "mapping_write",
+                    WriteKind::Cpu
+                ));
+                state.wire_watch.all_sampled_us = None;
+                tick(&mut state, &host);
+            }
+            for quiet in [
+                "wire_watch_layout_unverified",
+                "wire_watch transition",
+                "wire_watch inconclusive",
+                "wire_watch retired",
+                "wire_guard",
+            ] {
+                assert!(
+                    lines_with(&cap, quiet).is_empty(),
+                    "{quiet}: {:?}",
+                    cap.lines()
+                );
+            }
+            assert_eq!(state.wire_watch.watched[&MID].phase, Phase::Active);
+            assert!(state.wire_watch.cost.samples >= 6);
+        });
+    }
+}
