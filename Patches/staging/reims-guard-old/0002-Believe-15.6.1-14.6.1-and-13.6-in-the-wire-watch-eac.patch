+/// The kernel's string picks the layout and a mapping is held to it alone: a
+/// mapping laid out the other way, an `IOSurface` of the other kernel, a
+/// descriptor kept where the other kernel keeps it, or one of another class is
+/// refused by name, never tried against the other layout, and never refuses a
+/// write.
+#[test]
+fn a_mapping_is_checked_against_its_own_kernels_layout_only() {
+    type Case = (&'static str, &'static str, fn(&mut FakeHost), &'static str);
+    let cases: [Case; 7] = [
+        (
+            "27.2 kernel, unshifted MappingInternal",
+            KERNEL_VERSION_27_2,
+            |h| put_unshifted(h, &old_surface(), &UNSHIFTED_13_6, 1),
+            "mi_unshifted_layout",
+        ),
+        (
+            "13.6 kernel, shifted MappingInternal",
+            KERNEL_VERSION_13_6,
+            |h| put_surface(h, &old_surface(), 1),
+            "mi_page_count",
+        ),
+        (
+            "13.6 kernel, 14.6.1's IOSurface",
+            KERNEL_VERSION_13_6,
+            |h| put_unshifted(h, &old_surface(), &UNSHIFTED_14_6_1, 1),
+            "iosurface_class",
+        ),
+        (
+            "14.6.1 kernel, 13.6's IOSurface",
+            KERNEL_VERSION_14_6_1,
+            |h| put_unshifted(h, &old_surface(), &UNSHIFTED_13_6, 1),
+            "iosurface_class",
+        ),
+        (
+            "13.6 kernel, descriptor where 14.6.1 keeps it",
+            KERNEL_VERSION_13_6,
+            |h| {
+                put_unshifted(h, &old_surface(), &UNSHIFTED_13_6, 1);
+                put64(h, IOSURFACE + 0x38, 0);
+                put64(h, IOSURFACE + 0x30, SURFACE);
+            },
+            "iomd_pointer",
+        ),
+        (
+            "13.6 kernel, the IOSurface's descriptor of another class",
+            KERNEL_VERSION_13_6,
+            |h| {
+                put_unshifted(h, &old_surface(), &UNSHIFTED_13_6, 1);
+                put64(h, SURFACE, 0x5b95_7e00_2000_0638);
+            },
+            "iomd_class",
+        ),
+        (
+            "14.6.1 kernel, another device's MappingInternal",
+            KERNEL_VERSION_14_6_1,
+            |h| {
+                put_unshifted(h, &old_surface(), &UNSHIFTED_14_6_1, 1);
+                put64(h, MI + MI_OWNER, MAPPER + 0x1000);
+            },
+            "mi_owner",
+        ),
+    ];
+    for (what, version, set_up, reason) in cases {
+        with_switches(true, true, || {
+            let (mut state, mut host) = fixture_with(version, set_up);
+            let cap = crate::observe::FailCapture::start();
+            on_map(&mut state, &host, MID);
+            let refused = cap.one("wire_watch_layout_unverified");
+            assert!(
+                refused.contains("scope=mapping mapping=2")
+                    && refused.contains(&format!("reason={reason} ")),
+                "{what}: {refused}"
+            );
+            assert!(lines_with(&cap, "wire_watch map ").is_empty(), "{what}");
+            set_surface_wire(&mut host, 0);
+            assert!(
+                write_now(&mut state, &host, MID, "mapping_write", WriteKind::Cpu),
+                "{what}: an unchecked mapping never refuses a write"
+            );
+            on_map(&mut state, &host, MID);
+            assert_eq!(
+                lines_with(&cap, "wire_watch_layout_unverified").len(),
+                1,
+                "{what}: said once, and not retried another way"
+            );
+            assert!(lines_with(&cap, "wire_watch map ").is_empty(), "{what}");
+        });
+    }
+}
