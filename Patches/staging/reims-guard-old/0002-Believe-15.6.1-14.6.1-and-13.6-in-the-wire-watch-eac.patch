+// MARK: - 15.6.1, and the unshifted layout of 14.6.1 and 13.6
+
+/// The `IOSurface` mapping 2's MappingInternal names on the unshifted layout.
+const IOSURFACE: u64 = 0xffff_fe24_13d6_0000;
+/// The page-table descriptor's mapping, `MappingInternal +0x50` there.
+const TABLE_MAP: u64 = 0xffff_fe1e_47da_9000;
+/// The unshifted layout's eviction deadline and two-table-pages flag.
+const DEADLINE: u64 = 0x58;
+const TWO_TABLE_PAGES: u64 = 0x60;
+/// Another surface's `IOSurface` and descriptor, the descriptor at a wire count
+/// of zero and of the same class: what a freed and reused MappingInternal can
+/// name.
+const OTHER_IOSURFACE: u64 = 0xffff_fe24_13d6_8000;
+const OTHER_IOMD: u64 = 0xffff_fe24_13d7_8398;
+
+/// `pointer` signed as the guest signs a vtable pointer.
+fn signed(pointer: u64) -> u64 {
+    pointer & ((1 << 47) - 1) | 0x2a5c_0000_0000_0000
+}
+
+/// An `IOSurface` of `layout`'s kernel at `at`, keeping `descriptor`.
+fn put_iosurface(host: &mut FakeHost, layout: &Layout, at: u64, descriptor: u64) {
+    let SurfaceAt::IoSurface {
+        descriptor: field,
+        vtable_from_header,
+    } = layout.surface
+    else {
+        panic!("the {} layout has no IOSurface", layout.name);
+    };
+    put64(host, at, signed(KERNEL + vtable_from_header));
+    put64(host, at + field, descriptor);
+}
+
+/// Mapping 2 as 13.6 and 14.6.1 lay it out: a 0x78-byte MappingInternal whose
+/// `+0x20` is an `IOSurface` keeping the surface descriptor, the page-table
+/// descriptor at `+0x48`, its mapping at `+0x50`, an eviction deadline left at
+/// `+0x58` by an earlier `complete()`, and the page counts at `+0x68`/`+0x70`.
+fn put_unshifted(host: &mut FakeHost, s: &Surface, layout: &Layout, wire: u32) {
+    let n = s.gpas.len() as u64;
+    put32(host, s.mi + MI_STATE, 5);
+    put64(host, s.mi + MI_OWNER, MAPPER);
+    put64(host, s.mi + MI_OBJECT, IOSURFACE);
+    put32(host, s.mi + MI_ID, s.mid);
+    put32(host, s.mi + MI_SIZE, MAPPING_INTERNAL_EXPECTED_SIZE);
+    put64(host, s.mi + layout.table_iomd, s.table);
+    put64(host, s.mi + 0x50, TABLE_MAP);
+    put64(host, s.mi + DEADLINE, 0x0000_0123_4567_89ab);
+    put64(host, s.mi + TWO_TABLE_PAGES, 0);
+    put64(host, s.mi + 0x68, 1);
+    put64(host, s.mi + layout.page_count, n);
+    put_iosurface(host, layout, IOSURFACE, s.surface);
+    put_iomd(host, s.surface, n * PAGE, wire, n as u32, 0);
+    put_iomd(host, s.table, PAGE, 2, 1, s.page_table);
+    for (i, &gpa) in s.gpas.iter().enumerate() {
+        put32(host, s.page_table + 4 * i as u64, entry(gpa));
+        host.map_range(gpa, PAGE as usize, 0);
+    }
+    put64(host, MIXED + MIXED_DATA_LENGTH, 0x2000);
+}
+
+/// The other surface: its descriptor, and on the unshifted layout its
+/// `IOSurface`.
+fn put_other(host: &mut FakeHost, layout: &Layout) {
+    let n = G.len() as u64;
+    put_iomd(host, OTHER_IOMD, n * PAGE, 0, n as u32, 0);
+    if layout.surface != SurfaceAt::Descriptor {
+        put_iosurface(host, layout, OTHER_IOSURFACE, OTHER_IOMD);
+    }
+}
+
+/// Mapping 2 laid out as `layout` says, under the kernel `version`.
+fn laid_out(version: &str, layout: Layout) -> (DeviceState, FakeHost) {
+    fixture_with(version, |host| {
+        if layout.surface == SurfaceAt::Descriptor {
+            put_surface(host, &old_surface(), 1);
+        } else {
+            put_unshifted(host, &old_surface(), &layout, 1);
+        }
+        put_other(host, &layout);
+    })
+}
+
+/// What `MappingInternal +0x20` names on `layout`: mapping 2's own object, and
+/// the other surface's.
+fn objects(layout: &Layout) -> (u64, u64) {
+    match layout.surface {
+        SurfaceAt::Descriptor => (SURFACE, OTHER_IOMD),
+        SurfaceAt::IoSurface { .. } => (IOSURFACE, OTHER_IOSURFACE),
+    }
+}
