+/// The guest swaps mapping 2's MappingInternal to another surface between the
+/// two reads of one sample and back, so the first read follows it to a
+/// descriptor at zero. Nothing is concluded: no transition, no anomaly, no
+/// condemnation, no loss, no refusal. The next sample reads the mapping as it
+/// is, and a real drop is found then.
+#[test]
+fn an_object_swapped_mid_read_is_inconclusive_and_never_a_count() {
+    use crate::runtime::host::Rewire;
+    for (version, layout) in [
+        (KERNEL_VERSION_13_6, UNSHIFTED_13_6),
+        (KERNEL_VERSION_14_6_1, UNSHIFTED_14_6_1),
+        (KERNEL_VERSION_27_2, SHIFTED),
+    ] {
+        with_switches(true, true, || {
+            let (mut state, mut host) = laid_out(version, layout);
+            on_map(&mut state, &host, MID);
+            let (own, other) = objects(&layout);
+            let cap = crate::observe::FailCapture::start();
+            host.arm_rewire(Rewire {
+                on_read_gpa: MI + MI_ID,
+                on_read_len: 4,
+                pte_gpa: MI + MI_OBJECT,
+                bytes: other.to_le_bytes().to_vec(),
+            });
+            host.arm_rewire(Rewire {
+                on_read_gpa: OTHER_IOMD + IOMD_WIRE_COUNT,
+                on_read_len: 4,
+                pte_gpa: MI + MI_OBJECT,
+                bytes: own.to_le_bytes().to_vec(),
+            });
+            assert!(write_now(
+                &mut state,
+                &host,
+                MID,
+                "mapping_write",
+                WriteKind::Cpu
+            ));
+            assert_eq!(
+                host.rewires_fired(),
+                2,
+                "{}: the swap and the swap back both fell inside the sample",
+                layout.name
+            );
+            let inconclusive = lines_with(&cap, "wire_watch inconclusive");
+            assert_eq!(inconclusive.len(), 1, "{:?}", cap.lines());
+            assert!(
+                inconclusive[0].contains("mapping=2 ")
+                    && inconclusive[0].contains("link=mapping_internal n=1 at=mapping_write"),
+                "{}",
+                inconclusive[0]
+            );
+            for quiet in [
+                "wire_watch transition",
+                "wire_watch first_anomaly",
+                "wire_watch retired",
+                "wire_guard",
+            ] {
+                assert!(
+                    lines_with(&cap, quiet).is_empty(),
+                    "{quiet}: {:?}",
+                    cap.lines()
+                );
+            }
+            assert_eq!(state.wire_watch.cost.inconclusive, 1);
+            assert_eq!(state.wire_watch.watched[&MID].phase, Phase::Active);
+            assert_eq!(state.wire_watch.watched[&MID].last.surface, 1);
+
+            set_surface_wire(&mut host, 0);
+            assert!(!write_now(
+                &mut state,
+                &host,
+                MID,
+                "mapping_write",
+                WriteKind::Cpu
+            ));
+            assert_eq!(
+                lines_with(&cap, "wire_watch first_anomaly ").len(),
+                1,
+                "{:?}",
+                cap.lines()
+            );
+        });
+    }
+}
