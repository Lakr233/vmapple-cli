+/// 13.6 completes both descriptors after an `UNMAP` that failed or timed out,
+/// and can then free the MappingInternal. Here that `UNMAP` never reached this
+/// device, and before any sample saw a count drop the MappingInternal reads as
+/// another mapping's. That is no count and no condemnation: no anomaly,
+/// nothing withdrawn, the pages still read. But the permission its `MAP` gave
+/// is gone: writes are refused, CPU and GPU, and the owed frame is dropped,
+/// until a fresh `MAP` checks the incarnation again. The same holds on 27.2's
+/// layout. With the guard off the watch says so and refuses nothing.
+#[test]
+fn a_lost_incarnation_is_refused_until_a_fresh_map_and_never_condemned() {
+    use crate::runtime::writeback_debt::{pay_for_mapping, test_resident_identity};
+    for (version, layout) in [
+        (KERNEL_VERSION_13_6, UNSHIFTED_13_6),
+        (KERNEL_VERSION_27_2, SHIFTED),
+    ] {
+        with_switches(true, true, || {
+            let (mut state, mut host) = laid_out(version, layout);
+            on_map(&mut state, &host, MID);
+            let generation = state.mappings[&MID].map_generation;
+            let _ = state.pending_writebacks.arm(
+                MID,
+                test_resident_identity(MID, 4, 4, 1),
+                4,
+                4,
+                generation,
+            );
+            let cap = crate::observe::FailCapture::start();
+            // Freed and handed to mapping 7: another id, another surface.
+            let (_, other) = objects(&layout);
+            put32(&mut host, MI + MI_ID, 7);
+            put64(&mut host, MI + MI_OBJECT, other);
+            tick(&mut state, &host);
+            let lost = lines_with(&cap, "wire_watch identity_lost");
+            assert_eq!(lost.len(), 1, "{:?}", cap.lines());
+            assert!(
+                lost[0].contains("mapping=2 ")
+                    && lost[0].contains("reason=mapping_internal ")
+                    && lost[0].contains("condemned=0 guard=on"),
+                "{}",
+                lost[0]
+            );
+            for quiet in [
+                "wire_watch transition",
+                "wire_watch first_anomaly",
+                "wire_guard_condemned",
+                "wire_watch retired",
+            ] {
+                assert!(
+                    lines_with(&cap, quiet).is_empty(),
+                    "{quiet}: {:?}",
+                    cap.lines()
+                );
+            }
+            assert!(!is_withdrawn(&state, MID) && !guest_pages_condemned(&state, MID));
+            assert!(
+                state.pending_writebacks.get(MID).is_some(),
+                "no condemnation took the owed frame"
+            );
+            assert_eq!(
+                (state.wire_watch.cost.lost, state.wire_watch.cost.condemned),
+                (1, 0)
+            );
+
+            assert!(!write_now(
+                &mut state,
+                &host,
+                MID,
+                "mapping_write",
+                WriteKind::Cpu
+            ));
+            assert!(!write_now(
+                &mut state,
+                &host,
+                MID,
+                "gpu_writeback",
+                WriteKind::Gpu
+            ));
+            let refused = lines_with(&cap, "wire_guard_unowned_refused");
+            assert_eq!(refused.len(), 2, "n=1 and n=2: {:?}", cap.lines());
+            assert!(
+                refused[0]
+                    .contains("mapping=2 site=mapping_write kind=Cpu lost=mapping_internal n=1")
+                    && refused[1].contains("site=gpu_writeback kind=Gpu lost=mapping_internal n=2"),
+                "{refused:?}"
+            );
+            let dropped = route("wbdebt_dropped_unowned");
+            pay_for_mapping(&mut state, &mut host, MID);
+            assert_eq!(route("wbdebt_dropped_unowned"), dropped + 1);
+            assert!(state.pending_writebacks.get(MID).is_none());
+            assert_eq!(state.wire_watch.cost.unowned_refused, 3);
+            assert!(
+                !refuse_guest_read(&mut state, MID, "mapping_read"),
+                "a lost incarnation's pages are not refused to readers"
+            );
+            assert_eq!(state.wire_watch.cost.reads_refused, 0);
+
+            // The guest makes the incarnation again where it was and wires it.
+            put32(&mut host, MI + MI_ID, MID);
+            put64(&mut host, MI + MI_OBJECT, objects(&layout).0);
+            on_map(&mut state, &host, MID);
+            let cleared = lines_with(&cap, "wire_guard_unowned_cleared mapping=2 ");
+            assert_eq!(cleared.len(), 1, "{:?}", cap.lines());
+            assert!(
+                cleared[0].contains("lost=mapping_internal refused=3 reason=fresh_map"),
+                "{}",
+                cleared[0]
+            );
+            assert_eq!(lines_with(&cap, "wire_watch map mapping=2 ").len(), 1);
+            assert!(write_now(
+                &mut state,
+                &host,
+                MID,
+                "mapping_write",
+                WriteKind::Cpu
+            ));
+        });
+        with_switches(true, false, || {
+            let (mut state, mut host) = laid_out(version, layout);
+            on_map(&mut state, &host, MID);
+            let cap = crate::observe::FailCapture::start();
+            put32(&mut host, MI + MI_ID, 7);
+            assert!(
+                write_now(&mut state, &host, MID, "mapping_write", WriteKind::Cpu),
+                "the watch alone never refuses"
+            );
+            assert!(lines_with(&cap, "wire_watch identity_lost")[0].contains("guard=off"));
+            assert!(lines_with(&cap, "wire_guard").is_empty());
+        });
+    }
+}
