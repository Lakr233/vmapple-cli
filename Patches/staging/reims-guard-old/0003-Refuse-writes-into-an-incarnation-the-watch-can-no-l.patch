+/// The whole 13.6 sequence with the drop seen: the guest's `UNMAP` times out
+/// and never reaches this device, 13.6 completes both descriptors anyway, and
+/// later frees the MappingInternal. The drop condemns as on 27.2, and the
+/// condemnation outlives the MappingInternal: when it reads as another object
+/// the incarnation is lost as well, still condemned, and writes stay refused;
+/// retiring it there would have handed the writes back. The late `UNMAP` ends
+/// it, and a new MappingInternal under the id is written again.
+#[test]
+fn a_failed_13_6_unmap_condemns_and_the_condemnation_outlives_the_internal() {
+    with_switches(true, true, || {
+        let (mut state, mut host) = laid_out(KERNEL_VERSION_13_6, UNSHIFTED_13_6);
+        on_map(&mut state, &host, MID);
+        let cap = crate::observe::FailCapture::start();
+        put32(&mut host, TABLE + IOMD_WIRE_COUNT, 1);
+        set_surface_wire(&mut host, 0);
+        tick(&mut state, &host);
+        assert!(cap
+            .one("wire_guard_condemned")
+            .contains("mapping=2 field=surface"));
+        assert!(!write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+
+        put32(&mut host, MI + MI_ID, 7);
+        put64(&mut host, MI + MI_OBJECT, OTHER_IOSURFACE);
+        state.wire_watch.all_sampled_us = None;
+        tick(&mut state, &host);
+        let lost = lines_with(&cap, "wire_watch identity_lost");
+        assert_eq!(lost.len(), 1, "{:?}", cap.lines());
+        assert!(lost[0].contains("condemned=1"), "{}", lost[0]);
+        assert!(lines_with(&cap, "wire_watch retired").is_empty());
+        assert!(guest_pages_condemned(&state, MID));
+        assert!(!write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+        assert_eq!(state.wire_watch.watched[&MID].refused, 2);
+        // A MAP restating the incarnation does not wash it.
+        on_map(&mut state, &host, MID);
+        assert!(!write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+
+        on_unmap(&mut state, &host, MID);
+        let unmap = lines_with(&cap, "wire_watch unmap mapping=2 ");
+        assert!(unmap[0].contains("lost=mapping_internal"), "{}", unmap[0]);
+        assert!(state.unmap_surface(MID));
+        let again = Surface {
+            mi: MI + 0x1000,
+            ..old_surface()
+        };
+        put_unshifted(&mut host, &again, &UNSHIFTED_13_6, 1);
+        adopt(&mut state, &again);
+        on_map(&mut state, &host, MID);
+        assert!(!guest_pages_condemned(&state, MID));
+        assert!(write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+    });
+}
