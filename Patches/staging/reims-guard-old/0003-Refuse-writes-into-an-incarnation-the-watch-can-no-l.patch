+/// A checked incarnation whose chain now reads, twice alike, as something
+/// other than what was checked, with no `UNMAP` for it. That is not a count:
+/// nothing is condemned, no anomaly is said, and its pages are still read. But
+/// the `MAP` the write permission came from no longer describes it, and no
+/// `UNMAP` is no proof its pages are still wired: 13.6 completes both
+/// descriptors after an `UNMAP` that failed or timed out, and can then free the
+/// `MappingInternal`. So the guard refuses writes into it from here until a
+/// fresh `MAP` checks it again, or an `UNMAP` ends it.
+fn lose(ww: &mut WireWatch, mapping_id: u32, reason: &'static str, seen: String, at: &str) {
+    let Some(w) = ww.watched.get_mut(&mapping_id) else {
+        return;
+    };
+    let t_us = now_us();
+    w.phase = Phase::Lost(Lost { reason, t_us });
+    ww.cost.lost += 1;
+    let guard = guard_enabled();
+    crate::observe::fail(format!(
+        "wire_watch identity_lost mapping={mapping_id} internal={:#x} reason={reason} {seen} \
+         condemned={} guard={} at={at} t_us={t_us} (the chain no longer reads as the one checked \
+         at MAP and no UNMAP has come for it; {})",
+        w.internal,
+        w.condemned.is_some() as u8,
+        if guard { "on" } else { "off" },
+        if guard {
+            "writes into this incarnation are refused until a fresh MAP"
+        } else {
+            "the watch alone refuses nothing"
+        }
+    ));
+}
