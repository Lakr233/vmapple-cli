+// MARK: - A MAP of a lost incarnation
+
+/// Mapping 2 on 13.6, lost: its MappingInternal freed and handed to mapping 7
+/// before any drop was seen, then made again where it was, by the same
+/// IOSurface. The guest's next MAP of it comes next.
+fn lost_and_made_again() -> (DeviceState, FakeHost) {
+    let (mut state, mut host) = laid_out(KERNEL_VERSION_13_6, UNSHIFTED_13_6);
+    on_map(&mut state, &host, MID);
+    put32(&mut host, MI + MI_ID, 7);
+    put64(&mut host, MI + MI_OBJECT, OTHER_IOSURFACE);
+    tick(&mut state, &host);
+    assert_eq!(
+        state.wire_watch.watched[&MID].unowned.map(|l| l.reason),
+        Some("mapping_internal")
+    );
+    put32(&mut host, MI + MI_ID, MID);
+    put64(&mut host, MI + MI_OBJECT, IOSURFACE);
+    (state, host)
+}
+
+/// Swap mapping 2's IOSurface for the other surface's at the next read of its
+/// MappingInternal, and back at the next read of the other descriptor: the
+/// two reads of one check name different chains.
+fn arm_swap_and_back(host: &mut FakeHost) {
+    use crate::runtime::host::Rewire;
+    host.arm_rewire(Rewire {
+        on_read_gpa: MI + MI_ID,
+        on_read_len: 4,
+        pte_gpa: MI + MI_OBJECT,
+        bytes: OTHER_IOSURFACE.to_le_bytes().to_vec(),
+    });
+    host.arm_rewire(Rewire {
+        on_read_gpa: OTHER_IOMD + IOMD_WIRE_COUNT,
+        on_read_len: 4,
+        pte_gpa: MI + MI_OBJECT,
+        bytes: IOSURFACE.to_le_bytes().to_vec(),
+    });
+}
+
+/// After a MAP of a lost incarnation that did not verify: the refusal is
+/// kept, said for `why` at the MAP, and the next write is refused. Nothing is
+/// condemned and nothing is cleared.
+fn assert_still_refused(
+    state: &mut DeviceState,
+    host: &FakeHost,
+    cap: &crate::observe::FailCapture,
+    why: &str,
+) {
+    let kept = lines_with(cap, "wire_guard_unowned_kept mapping=2 ");
+    assert_eq!(kept.len(), 1, "{why}: {:?}", cap.lines());
+    assert!(
+        kept[0].contains(&format!("lost=mapping_internal why={why} at=map")),
+        "{}",
+        kept[0]
+    );
+    assert!(
+        !write_now(state, host, MID, "mapping_write", WriteKind::Cpu),
+        "{why}: a MAP that did not verify gives the writes back"
+    );
+    assert_eq!(
+        state.wire_watch.watched[&MID].unowned.map(|l| l.reason),
+        Some("mapping_internal"),
+        "{why}"
+    );
+    for quiet in ["wire_guard_unowned_cleared", "wire_guard_condemned"] {
+        assert!(
+            lines_with(cap, quiet).is_empty(),
+            "{quiet}: {:?}",
+            cap.lines()
+        );
+    }
+    assert!(
+        !lines_with(cap, "wire_guard_unowned_refused").is_empty(),
+        "{:?}",
+        cap.lines()
+    );
+}
+
+/// The MAP of a lost incarnation cannot be read: it stays refused, and so
+/// does a write while it still cannot. Once this MAP's chain reads whole with
+/// both counts positive, the refusal is lifted.
+#[test]
+fn an_unreadable_map_keeps_a_lost_incarnation_refused() {
+    with_switches(true, true, || {
+        let (mut state, mut host) = lost_and_made_again();
+        let cap = crate::observe::FailCapture::start();
+        host.kva_no_cpu = true;
+        on_map(&mut state, &host, MID);
+        assert_eq!(state.wire_watch.watched[&MID].phase, Phase::Pending);
+        assert_still_refused(&mut state, &host, &cap, "not_yet");
+        assert!(!write_now(
+            &mut state,
+            &host,
+            MID,
+            "gpu_writeback",
+            WriteKind::Gpu
+        ));
+
+        host.kva_no_cpu = false;
+        assert!(write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+        assert!(cap
+            .lines()
+            .iter()
+            .any(|l| l.contains("wire_guard_unowned_cleared mapping=2 ")
+                && l.contains("reason=verified_map at=late surface_wire=1 table_wire=2")));
+    });
+}
+
+/// The two reads of the MAP's chain disagree, and so do those of the next
+/// write's: refused both times. A check whose reads agree lifts it.
+#[test]
+fn a_map_whose_two_reads_disagree_keeps_a_lost_incarnation_refused() {
+    with_switches(true, true, || {
+        let (mut state, mut host) = lost_and_made_again();
+        let cap = crate::observe::FailCapture::start();
+        arm_swap_and_back(&mut host);
+        on_map(&mut state, &host, MID);
+        assert_eq!(host.rewires_fired(), 2);
+        assert!(lines_with(&cap, "wire_watch inconclusive mapping=2 ")[0].contains("at=map"));
+        arm_swap_and_back(&mut host);
+        assert_still_refused(&mut state, &host, &cap, "inconclusive:mapping_internal");
+        assert_eq!(
+            host.rewires_fired(),
+            4,
+            "the write's own check was swapped too"
+        );
+
+        assert!(write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+        assert_eq!(state.wire_watch.watched[&MID].unowned, None);
+    });
+}
