+        assert!(lines_with(&cap, "wire_guard_unowned_kept").is_empty());
+        let w = &state.wire_watch.watched[&MID];
+        assert_eq!((w.phase, w.unowned), (Phase::Active, None));
+        assert!(write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+        assert!(write_now(
+            &mut state,
+            &host,
+            MID,
+            "gpu_writeback",
+            WriteKind::Gpu
+        ));
+    });
+}
