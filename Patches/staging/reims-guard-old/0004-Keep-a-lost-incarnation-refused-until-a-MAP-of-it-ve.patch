+        assert_eq!(state.wire_watch.watched[&MID].phase, Phase::Lost);
+        assert_still_refused(&mut state, &host, &cap, "map_wire_not_positive");
+
+        set_surface_wire(&mut host, 1);
+        on_map(&mut state, &host, MID);
+        assert!(write_now(
