+    with_switches(true, true, || {
+        let (mut state, mut host) = lost_and_made_again();
+        let cap = crate::observe::FailCapture::start();
+        put64(&mut host, IOSURFACE, signed(KERNEL + 0xb0_fde8));
+        on_map(&mut state, &host, MID);
+        assert!(cap
+            .one("wire_watch_layout_unverified")
+            .contains("scope=mapping mapping=2 reason=iosurface_class "));
+        assert_eq!(state.wire_watch.watched[&MID].phase, Phase::Lost);
+        assert_still_refused(&mut state, &host, &cap, "iosurface_class");
+
+        put_iosurface(&mut host, &UNSHIFTED_13_6, IOSURFACE, SURFACE);
+        on_map(&mut state, &host, MID);
+        assert!(write_now(
+            &mut state,
+            &host,
+            MID,
+            "mapping_write",
+            WriteKind::Cpu
+        ));
+    });
+}
