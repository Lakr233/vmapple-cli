From 416c7e4a9f4608447f234b021be6cdc554241ea6 Mon Sep 17 00:00:00 2001
From: Lakr <git@qaq.wiki>
Date: Mon, 9 Nov 2026 13:50:59 +0800
Subject: [PATCH 09/14] hw/vmapple: Back 0x410000..0x700000 with RAM

Ported from vmapple-cli Patches/qemu/0002-hw-vmapple-Back-0x410000-0x700000-with-RAM.patch with fuzz.
---
 hw/vmapple/vmapple.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/hw/vmapple/vmapple.c b/hw/vmapple/vmapple.c
index 55eb98f473..4064388493 100644
--- a/hw/vmapple/vmapple.c
+++ b/hw/vmapple/vmapple.c
@@ -78,6 +78,7 @@ struct VMAppleMachineState {
     Notifier powerdown_notifier;
     PCIBus *bus;
     MemoryRegion fw_mr;
+    MemoryRegion scratch_mr;
     MemoryRegion ecam_alias;
     uint64_t uuid;
     char *tablet;
@@ -105,6 +106,7 @@ bool vmapple_read_current_xreg(unsigned int index, uint64_t *value)
 enum {
     VMAPPLE_FIRMWARE,
     VMAPPLE_CONFIG,
+    VMAPPLE_SCRATCH,
     VMAPPLE_MEM,
     VMAPPLE_GIC_DIST,
     VMAPPLE_GIC_REDIST,
@@ -127,6 +129,7 @@ enum {
 static const MemMapEntry memmap[] = {
     [VMAPPLE_FIRMWARE] =           { 0x00100000, 0x00100000 },
     [VMAPPLE_CONFIG] =             { 0x00400000, 0x00010000 },
+    [VMAPPLE_SCRATCH] =            { 0x00410000, 0x002f0000 },
 
     [VMAPPLE_GIC_DIST] =           { 0x10000000, 0x00010000 },
     [VMAPPLE_GIC_REDIST] =         { 0x10010000, 0x00400000 },
@@ -735,6 +738,11 @@ static void mach_vmapple_init(MachineState *machine)
     memory_region_add_subregion(sysmem, vms->memmap[VMAPPLE_MEM].base,
                                 machine->ram);
 
+    memory_region_init_ram(&vms->scratch_mr, NULL, "avp-scratch",
+                           vms->memmap[VMAPPLE_SCRATCH].size, &error_fatal);
+    memory_region_add_subregion(sysmem, vms->memmap[VMAPPLE_SCRATCH].base,
+                                &vms->scratch_mr);
+
     create_gic(vms, sysmem);
     create_gicv2m(vms);
     create_bdif(vms, sysmem);
-- 
