From 705d1c94d9bc21bd87953f132ff4b07ffa09e0b9 Mon Sep 17 00:00:00 2001
From: Lakr <git@qaq.wiki>
Date: Mon, 9 Nov 2026 13:51:49 +0800
Subject: [PATCH 12/14] hw/vmapple: keep the HVF kernel-entry hook out of KVM
 builds

---
 hw/vmapple/vmapple.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/hw/vmapple/vmapple.c b/hw/vmapple/vmapple.c
index 4064388493..3f91da3db4 100644
--- a/hw/vmapple/vmapple.c
+++ b/hw/vmapple/vmapple.c
@@ -507,6 +507,7 @@ static void create_pcie(VMAppleMachineState *vms)
     }
 }
 
+#ifdef CONFIG_HVF
 /*
  * macOS 14 and later need two changes to the kernel's memory to boot here,
  * made when iBoot enters the kernel. From reset, RAM is not executable: each
@@ -647,6 +648,7 @@ static bool vmapple_exec_fault(CPUState *cpu, hwaddr ipa)
                                 HV_MEMORY_EXEC));
     return true;
 }
+#endif /* CONFIG_HVF */
 
 static void vmapple_reset(void *opaque)
 {
@@ -654,10 +656,15 @@ static void vmapple_reset(void *opaque)
     hwaddr base = vms->memmap[VMAPPLE_FIRMWARE].base;
 
     cpu_set_pc(first_cpu, base);
+#ifdef CONFIG_HVF
+    if (!hvf_enabled()) {
+        return;
+    }
     hvf_arm_exec_fault = vmapple_exec_fault;
     assert_hvf_ok(hv_vm_protect(vms->memmap[VMAPPLE_MEM].base,
                                 MACHINE(vms)->ram_size,
                                 HV_MEMORY_READ | HV_MEMORY_WRITE));
+#endif
 }
 
 static void mach_vmapple_init(MachineState *machine)
