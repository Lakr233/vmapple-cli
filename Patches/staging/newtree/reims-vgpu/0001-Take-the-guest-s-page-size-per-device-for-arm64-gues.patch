+                .into_iter()
+                .map(|c| c.args[0].clone())
+                .collect();
+            assert_eq!(created, vec![Arg::val(&spec_for(&d, Some(ranges)))]);
+        }
+
+        /// A host-only surface of one byte counts one 16 KiB page against the host-only total
+        #[test]
+        fn host_only_counts_16k_pages() {
