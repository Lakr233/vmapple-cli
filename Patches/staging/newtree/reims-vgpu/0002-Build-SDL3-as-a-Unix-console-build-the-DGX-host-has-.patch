From 06d6fb5afc88e0b5261d91883ef4786a9ce583ad Mon Sep 17 00:00:00 2001
From: Lakr <git@qaq.wiki>
Date: Mon, 9 Nov 2026 13:55:24 +0800
Subject: [PATCH 2/4] Build SDL3 as a Unix console build: the DGX host has no
 X11 or Wayland development files

---
 Cargo.lock | 3 +++
 Cargo.toml | 2 ++
 2 files changed, 5 insertions(+)

diff --git a/Cargo.lock b/Cargo.lock
index c82d69262..06e8119d6 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -301,6 +301,7 @@ checksum = "cf8baf1c55e62ffcace7a9f06f4bd9cd3f0c4beb022d3b367256b91b87513d98"
 [[package]]
 name = "metal2vulkan"
 version = "0.2.0"
+source = "git+https://github.com/steelbrain/metal2vulkan?rev=219f01365dc4c8eb346816c405b5b17403793764#219f01365dc4c8eb346816c405b5b17403793764"
 dependencies = [
  "ash",
  "metal2vulkan-air",
@@ -311,6 +312,7 @@ dependencies = [
 [[package]]
 name = "metal2vulkan-air"
 version = "0.2.0"
+source = "git+https://github.com/steelbrain/metal2vulkan?rev=219f01365dc4c8eb346816c405b5b17403793764#219f01365dc4c8eb346816c405b5b17403793764"
 dependencies = [
  "sha2 0.11.1",
 ]
@@ -318,6 +320,7 @@ dependencies = [
 [[package]]
 name = "metal2vulkan-runtime"
 version = "0.2.0"
+source = "git+https://github.com/steelbrain/metal2vulkan?rev=219f01365dc4c8eb346816c405b5b17403793764#219f01365dc4c8eb346816c405b5b17403793764"
 dependencies = [
  "ash",
  "libc",
diff --git a/Cargo.toml b/Cargo.toml
index b789126e3..b8a70d0c2 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -58,6 +58,8 @@ sdl3-sys = { version = "=0.7.2", default-features = false, features = [
     "no-default-subsystems",
     "sdl-video",
     "use-ash-v0-38",
+    # Spike (DGX, headless): no X11 or Wayland development files on the host.
+    "sdl-unix-console-build",
 ] }
 # core (architecture 2.2)
 parking_lot = "0.12.5"
-- 
2.43.0

