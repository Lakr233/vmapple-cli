+// MARK: - Events
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum Ev {
+    Swap {
+        channel: u32,
+        head: u32,
+        opcode: u16,
+        stamp: u32,
+        slot: u32,
+        mapping: u32,
+        deferred: bool,
+        present: &'static str,
+    },
+    SwapHeld {
+        cause: &'static str,
+        channel: u32,
+        head: u32,
+        opcode: u16,
+        stamp: u32,
+        mapping: u32,
+    },
+    Stamp {
+        slot: u32,
+        value: u32,
+        queued: bool,
+        swaps: Vec<(u64, u32)>,
+    },
+    Present {
+        kind: &'static str,
+    },
+    Hold {
+        held: u32,
+        new: u32,
+        producer: u32,
+    },
+    HoldRelease {
+        held: u32,
+        held_us: u64,
+    },
+    Map {
+        mapping: u32,
+        surface: u32,
+        table: u32,
+    },
+    Unmap {
+        mapping: u32,
+    },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Event {
+    seq: u64,
+    t_us: u64,
+    /// Display refresh-class present signals raised so far; see
+    /// [`note_refresh_signal`].
+    refresh: u64,
+    ev: Ev,
+}
+
+impl std::fmt::Display for Event {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "seq={} t_us={} refresh={} ",
+            self.seq, self.t_us, self.refresh
+        )?;
+        match &self.ev {
+            Ev::Swap {
+                channel,
+                head,
+                opcode,
+                stamp,
+                slot,
+                mapping,
+                deferred,
+                present,
+            } => write!(
+                f,
+                "ev=swap ch={channel} head={head:#x} op={opcode:#x} stamp={stamp:#x} slot={slot} \
+                 mapping={mapping} how={} present={present}",
+                if *deferred { "deferred" } else { "exec" }
+            ),
+            Ev::SwapHeld {
+                cause,
+                channel,
+                head,
+                opcode,
+                stamp,
+                mapping,
+            } => write!(
+                f,
+                "ev=swap_held cause={cause} ch={channel} head={head:#x} op={opcode:#x} \
+                 stamp={stamp:#x} mapping={mapping}"
+            ),
+            Ev::Stamp {
+                slot,
+                value,
+                queued,
+                swaps,
+            } => {
+                write!(
+                    f,
+                    "ev=stamp slot={slot} value={value:#x} route={} swaps=[",
+                    if *queued { "queued" } else { "direct" }
+                )?;
+                for (i, (seq, mapping)) in swaps.iter().enumerate() {
+                    let sep = if i == 0 { "" } else { "," };
+                    write!(f, "{sep}{seq}:{mapping}")?;
+                }
+                write!(f, "]")
+            }
+            Ev::Present { kind } => write!(f, "ev=present kind={kind}"),
+            Ev::Hold {
+                held,
+                new,
+                producer,
+            } => write!(
+                f,
+                "ev=hold held_mask={held:#x} new_mask={new:#x} producer_mask={producer:#x}"
+            ),
+            Ev::HoldRelease { held, held_us } => {
+                write!(f, "ev=hold_release held_mask={held:#x} held_us={held_us}")
+            }
+            Ev::Map {
+                mapping,
+                surface,
+                table,
+            } => write!(
+                f,
+                "ev=map mapping={mapping} surface={surface} table={table}"
+            ),
+            Ev::Unmap { mapping } => write!(f, "ev=unmap mapping={mapping}"),
+        }
+    }
+}
+
+/// One display swap the device completed, waiting for the stamp that tells the
+/// guest so.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Unstamped {
+    seq: u64,
+    slot: u32,
+    stamp: u32,
+    mapping: u32,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct WriteNote {
+    mapping: u32,
+    site: String,
+    t_us: u64,
+}
+
+impl std::fmt::Display for WriteNote {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "{{mapping={},site={},t_us={}}}",
+            self.mapping, self.site, self.t_us
+        )
+    }
+}
