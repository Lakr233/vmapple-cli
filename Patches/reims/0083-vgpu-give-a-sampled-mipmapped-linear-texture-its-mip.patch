From c5e483bc131408631f2143e93d07da2c3cdd2c05 Mon Sep 17 00:00:00 2001
From: Lakr233 <git@qaq.wiki>
Date: Sat, 14 Nov 2026 01:21:44 +0800
Subject: [PATCH 83/83] vgpu: give a sampled mipmapped linear texture its mip
 levels

Component: Vulkan draw, sampled linear textures.

0080 generated mip levels for a sampled mipmapped heap texture. The
backdrop blur a window's glass samples is a mipmapped linear texture
(256x256 RGBA16F), whose levels above 0 the guest's downsample kernel
writes and this device drops, and it was bound with one level.

A sampled 2D linear texture that declares more than one level now gets
them too. A bind with levels is not bound over guest memory directly,
which has the guest's one level, but gathered into an image whose levels
are generated after the copy, as 0080 does for uploads.

Measured on arm64 Linux (NVIDIA GB10), macOS 27.2 guest at protocol 237:
299 mipmapped binds in a cold boot, menus and the Dock drawn as before,
no panic.

Verified: the reims-vgpu test suite passes; clippy unchanged.
Not verified: the backend-metal arm.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/backend/vulkan/engine/exec.rs         | 11 ++++--
 crates/reims-vgpu/src/runtime/draw/vulkan.rs  | 36 ++++++++++++-------
 2 files changed, 32 insertions(+), 15 deletions(-)

diff --git a/crates/reims-vgpu/src/backend/vulkan/engine/exec.rs b/crates/reims-vgpu/src/backend/vulkan/engine/exec.rs
index ca60d94e0..b5cb18437 100644
--- a/crates/reims-vgpu/src/backend/vulkan/engine/exec.rs
+++ b/crates/reims-vgpu/src/backend/vulkan/engine/exec.rs
@@ -4063,7 +4063,14 @@ pub(crate) unsafe fn execute_draw_inner(
                     .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
             }
             SampledSource::GuestRuns(src, vouch) => {
-                if let Some(direct) = src.direct_image.as_ref() {
+                // An image over guest memory has the guest's one level; a bind that
+                // asks for more is gathered into an image whose levels are
+                // generated after the copy.
+                if let Some(direct) = src
+                    .direct_image
+                    .as_ref()
+                    .filter(|_| resource.mip_levels <= 1)
+                {
                     if let Some(bound) = unsafe {
                         pools.acquire_guest_sampled(
                             ctx,
@@ -5029,7 +5036,7 @@ pub(crate) unsafe fn execute_draw_inner(
             if *volume { 1 } else { *layers },
             if *volume { *layers } else { 1 },
             *row_length_texels,
-            1,
+            img.mip_levels,
         );
     }
 
diff --git a/crates/reims-vgpu/src/runtime/draw/vulkan.rs b/crates/reims-vgpu/src/runtime/draw/vulkan.rs
index b55459079..fdc57e01d 100644
--- a/crates/reims-vgpu/src/runtime/draw/vulkan.rs
+++ b/crates/reims-vgpu/src/runtime/draw/vulkan.rs
@@ -8545,30 +8545,40 @@ fn try_metal2vulkan_draw<M: HostMemory + HostOps>(
                 } else {
                     (tw, th)
                 };
-                // A mipmapped heap texture's snapshot holds its base level. The
-                // levels above it are generated by halving, which is what the
-                // guest's own downsample kernel writes and this device cannot:
-                // a glass shader samples them for its blur, and level 0 alone
-                // blurs far less than a Mac does.
+                // A mipmapped texture is bound with its base level, and the
+                // levels above it are generated by halving. Those are what the
+                // guest's downsample kernels write and this device cannot: a
+                // heap texture keeps only level 0, and a kernel's write to a
+                // linear texture's higher level is dropped. The Liquid Glass
+                // shaders sample the backdrop blur at a level of detail, and
+                // level 0 alone left a window's glass rim sharp and tinted by
+                // the wallpaper beside it.
                 let mip_levels = texture_resource
                     .as_ref()
                     .filter(|_| {
-                        matches!(
+                        !matches!(
                             source,
-                            crate::backend::vulkan::engine::SampledSource::Bytes(_)
+                            crate::backend::vulkan::engine::SampledSource::Target(_)
                         ) && !arrayed
                             && !volume
                             && !cube
                             && !one_dim
                     })
-                    .and_then(|resource| heap_texture_of(&resource.descriptor))
-                    .map_or(1, |heap| {
-                        heap.mip_levels
-                            .min(32 - tw.max(th).max(1).leading_zeros())
-                            .max(1)
+                    .and_then(|resource| {
+                        heap_texture_of(&resource.descriptor)
+                            .map(|heap| heap.mip_levels)
+                            .or_else(|| match resource.decoded() {
+                                Ok(crate::runtime::decode::resource::Descriptor::Texture(tex)) => {
+                                    Some(tex.mipmap_level_count)
+                                }
+                                _ => None,
+                            })
+                    })
+                    .map_or(1, |levels| {
+                        levels.min(32 - tw.max(th).max(1).leading_zeros()).max(1)
                     });
                 if mip_levels > 1 {
-                    crate::runtime::drain::note_store_route("heap_sample_mipmapped");
+                    crate::runtime::drain::note_store_route("sampled_mipmapped");
                 }
                 images.push(crate::backend::vulkan::engine::SampledImageResource {
                     binding: img_bind,
