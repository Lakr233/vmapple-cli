+/// One sandwiched sample of `len` bytes at `kva`, taken on a vCPU: `None` when
+/// the CPU cannot read it at all.
+pub fn sample_on_cpu<H: HostMemory + HostOps>(
+    host: &H,
+    root: &KernelRoot,
+    kva: u64,
+    len: usize,
+    source: Source,
+) -> Option<WalkCompare> {
