+            crate::observe::fail(format!(
+                "gva_write fail reason={reason} task={task_id} gva={row_gva:#x} span={span:#x} \
+                 row={y} rowlen={:#x} (native multi)",
+                src.len()
+            ));
+            return Err(err);
+        }
+    }
+    Ok(())
