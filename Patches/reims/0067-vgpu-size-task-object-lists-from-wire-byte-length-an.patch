diff --git a/crates/reims-vgpu/src/runtime/drain/mod.rs b/crates/reims-vgpu/src/runtime/drain/mod.rs
index 2fdc48c7f..29072e837 100644
--- a/crates/reims-vgpu/src/runtime/drain/mod.rs
+++ b/crates/reims-vgpu/src/runtime/drain/mod.rs
@@ -511,7 +511,13 @@ fn apply_set_object_list(state: &mut DeviceState, payload: &[u8], channel: Optio
     }
     let task_id = ld32(&payload[SET_OBJECT_LIST_TASK_ID..]);
     let pfn = ld32(&payload[SET_OBJECT_LIST_PFN..]);
-    let count = ld32(&payload[SET_OBJECT_LIST_COUNT..]);
+    // Wire `+0x08` carries the object-list allocation's byte length
+    // (`49_152` = 3 × 16 KiB = 4 096 × 12 B on arm64, growing to `98_304` =
+    // 8 192 × 12 B; `1_048_576` = 1 MiB = 87 381 × 12 B on x86), not an entry
+    // count. Converting to 12-byte slots bounds speculative probes to the
+    // mapped list allocation instead of walking 12× past its end.
+    let byte_len = ld32(&payload[SET_OBJECT_LIST_COUNT..]);
+    let count = byte_len / (crate::runtime::decode::resource::OBJECT_LIST_ENTRY_LEN as u32);
     // A new object list changes the construction input for references this
     // device has not constructed yet. Exact-window buffer resolutions are not
     // object states and therefore retire here. Typed objects already
@@ -529,7 +535,7 @@ fn apply_set_object_list(state: &mut DeviceState, payload: &[u8], channel: Optio
         (u64::from(task_id) << 48) ^ (u64::from(pfn) << 24) ^ u64::from(count),
     ) {
         crate::observe::off(format!(
-            "set_object_list site={} task={task_id} pfn={pfn:#x} count={count} \
+            "set_object_list site={} task={task_id} pfn={pfn:#x} bytes={byte_len} count={count} \
              applied={} plen={}",
             packet_site(channel),
             applied as u8,
diff --git a/crates/reims-vgpu/src/runtime/drain/tests.rs b/crates/reims-vgpu/src/runtime/drain/tests.rs
index d84340d64..61e8163b2 100644
--- a/crates/reims-vgpu/src/runtime/drain/tests.rs
+++ b/crates/reims-vgpu/src/runtime/drain/tests.rs
@@ -6788,3 +6788,49 @@ fn the_mapper_ring_backlog_names_an_overrun_and_a_consumer_ahead() {
     assert_eq!(ring_backlog(10, 4, 4), RingBacklog::Overrun { lost: 2 });
     assert_eq!(ring_backlog(3, 4, 4), RingBacklog::ConsumerAhead);
 }
+
+#[test]
+fn set_object_list_converts_wire_byte_length_to_12_byte_slot_count() {
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+    state.define_task(3, 0x1000, 1);
+
+    let mut root_payload = Vec::with_capacity(12);
+    root_payload.extend_from_slice(&3u32.to_le_bytes());
+    root_payload.extend_from_slice(&0x1u32.to_le_bytes());
+    root_payload.extend_from_slice(&49_152u32.to_le_bytes());
+    process_root_packet(
+        &mut state,
+        &mut host,
+        &Packet {
+            opcode: ROOT_OP_SET_OBJECT_LIST,
+            stamp_waits: Vec::new(),
+            total_size: PACKET_HEADER_LEN + 12,
+            completion_stamp: 0,
+            payload: root_payload,
+            next_head: 0,
+        },
+    );
+    assert_eq!(state.tasks[3].object_list_pfn, 0x1);
+    assert_eq!(state.tasks[3].object_list_count, 4096);
+
+    let mut child_payload = Vec::with_capacity(12);
+    child_payload.extend_from_slice(&3u32.to_le_bytes());
+    child_payload.extend_from_slice(&0x914u32.to_le_bytes());
+    child_payload.extend_from_slice(&98_304u32.to_le_bytes());
+    process_child_packet(
+        &mut state,
+        &mut host,
+        2,
+        &Packet {
+            opcode: CHILD_OP_SET_OBJECT_LIST,
+            stamp_waits: Vec::new(),
+            total_size: PACKET_HEADER_LEN + 12,
+            completion_stamp: 0,
+            payload: child_payload,
+            next_head: 0,
+        },
+    );
+    assert_eq!(state.tasks[3].object_list_pfn, 0x914);
+    assert_eq!(state.tasks[3].object_list_count, 8192);
+}
