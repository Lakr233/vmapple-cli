 .../src/backend/vulkan/engine/context.rs      |  5 ++-
 crates/reims-vgpu/src/env.rs                  | 31 +++++++++++++++++++
 crates/reims-vgpu/src/runtime/m2v_disk/mod.rs |  7 +++--
 3 files changed, 39 insertions(+), 4 deletions(-)

diff --git a/crates/reims-vgpu/src/backend/vulkan/engine/context.rs b/crates/reims-vgpu/src/backend/vulkan/engine/context.rs
index 8d18b15f8..a460617d6 100644
--- a/crates/reims-vgpu/src/backend/vulkan/engine/context.rs
+++ b/crates/reims-vgpu/src/backend/vulkan/engine/context.rs
@@ -133,7 +133,7 @@ fn pipeline_cache_disk_path(uuid: &[u8; 16]) -> std::path::PathBuf {
     for b in uuid {
         let _ = write!(hex, "{b:02x}");
     }
-    std::env::temp_dir().join(format!("reims-vgpu-vk-pipeline-cache-{hex}.bin"))
+    crate::env::cache_dir().join(format!("reims-vgpu-vk-pipeline-cache-{hex}.bin"))
 }
 
 /// Outcome of one atomic pipeline-cache blob save.
@@ -1264,6 +1264,9 @@ impl DeviceContext {
         // (passing a blob not produced by vkGetPipelineCacheData for this
         // device is a Vulkan valid-usage violation, not a soft fallback).
         let pipeline_cache_path = pipeline_cache_disk_path(&props.pipeline_cache_uuid);
+        if let Some(parent) = pipeline_cache_path.parent() {
+            let _ = std::fs::create_dir_all(parent);
+        }
         let initial_blob = match read_pipeline_cache_blob(&pipeline_cache_path, &props) {
             Ok(blob) => blob,
             Err(decline) => {
diff --git a/crates/reims-vgpu/src/env.rs b/crates/reims-vgpu/src/env.rs
index 33841eed2..17edcbee8 100644
--- a/crates/reims-vgpu/src/env.rs
+++ b/crates/reims-vgpu/src/env.rs
@@ -123,6 +123,22 @@ pub const GUEST_IMPORT: &str = "REIMS_VGPU_GUEST_IMPORT";
 /// differs (command-buffer state versus an allocated set).
 pub const PUSH_DESCRIPTORS: &str = "REIMS_VGPU_PUSH_DESCRIPTORS";
 
+/// Where the Vulkan pipeline cache and the metal2vulkan translation cache live.
+/// Unset or empty, they sit in `$TMPDIR` beside this device's logs. A launcher
+/// that gives each virtual machine its own `$TMPDIR` can point this at a
+/// directory several machines share, so a new machine starts with the pipelines
+/// an earlier one compiled instead of compiling them again. Both caches publish
+/// by rename and check what they read, so processes may share one directory.
+pub const CACHE_DIR: &str = "REIMS_VGPU_CACHE_DIR";
+
+/// The directory [`CACHE_DIR`] names, or `$TMPDIR`.
+pub fn cache_dir() -> std::path::PathBuf {
+    std::env::var_os(CACHE_DIR)
+        .filter(|value| !value.is_empty())
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(std::env::temp_dir)
+}
+
 /// Verbose per-draw logging on top of the always-on fail sink.
 pub const DRAW_LOG: &str = "REIMS_VGPU_DRAW_LOG";
 
@@ -1539,6 +1555,21 @@ mod tests {
         }
     }
 
+    /// The caches follow the variable when it names a directory and stay in
+    /// `$TMPDIR` when it is unset or empty.
+    #[test]
+    fn the_cache_directory_follows_its_variable() {
+        let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+        // SAFETY: the lock serializes every mutation of this variable in this
+        // process; `cache_dir` below is the only reader.
+        unsafe { std::env::set_var(CACHE_DIR, "/var/cache/reims-test") };
+        assert_eq!(cache_dir(), std::path::PathBuf::from("/var/cache/reims-test"));
+        unsafe { std::env::set_var(CACHE_DIR, "") };
+        assert_eq!(cache_dir(), std::env::temp_dir());
+        unsafe { std::env::remove_var(CACHE_DIR) };
+        assert_eq!(cache_dir(), std::env::temp_dir());
+    }
+
     /// A value the parse rejects reaches the line verbatim. An operator who
     /// wrote `disabled` instead of `off` otherwise reads `unset` and concludes
     /// the switch does not work.
diff --git a/crates/reims-vgpu/src/runtime/m2v_disk/mod.rs b/crates/reims-vgpu/src/runtime/m2v_disk/mod.rs
index 26de1e5b0..4e5e9cce8 100644
--- a/crates/reims-vgpu/src/runtime/m2v_disk/mod.rs
+++ b/crates/reims-vgpu/src/runtime/m2v_disk/mod.rs
@@ -45,8 +45,9 @@
 //!
 //! # On disk
 //!
-//! `$TMPDIR/reims-vgpu-m2v-cache/<translator>/` holds one `<identity>.m2v` per
-//! translation, and a `translator.txt` spelling out what `<translator>` stands
+//! `$TMPDIR/reims-vgpu-m2v-cache/<translator>/`, or the same under
+//! `REIMS_VGPU_CACHE_DIR` (see [`crate::env::CACHE_DIR`]), holds one
+//! `<identity>.m2v` per translation, and a `translator.txt` spelling out what `<translator>` stands
 //! for. A new translator starts an empty directory; the old one stays until an
 //! operator deletes it.
 //!
@@ -633,7 +634,7 @@ fn open_shared() -> Option<Arc<DiskCache>> {
         crate::observe::fail("linux_m2v_disk disabled reason=translator_source_unknown");
         return None;
     }
-    let root = std::env::temp_dir().join(ROOT);
+    let root = crate::env::cache_dir().join(ROOT);
     let started = Instant::now();
     let translator = translator_fingerprint();
     match DiskCache::open(&root, &translator) {
