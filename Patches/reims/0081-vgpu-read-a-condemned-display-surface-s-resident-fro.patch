@@ -2413,9 +2413,22 @@ pub(crate) fn stage_texture_raw<M: HostMemory + HostOps>(
             return Err(ComputeStatus::GuestIo("compute_stage_tex_type11_span"));
         }
         let mut bytes = vec![0u8; need];
+        let from_resident = serve.is_none()
+            && !is_storage
