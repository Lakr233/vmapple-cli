+        );
+        assert!(
+            worst_vcpu_wait < Duration::from_millis(20),
+            "a vCPU waited {worst_vcpu_wait:?} for the lock while the compile ran"
+        );
+        assert_eq!(rig.exec_stamp(), EXEC_STAMP);
+        assert_eq!(
+            pipeline_refs(&script.ran()),
+            [(111, "drawn"), (112, "pending"), (112, "drawn")]
+        );
+    }
+}
