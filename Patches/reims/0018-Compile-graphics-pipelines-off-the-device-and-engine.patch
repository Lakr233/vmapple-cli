+
+pub(crate) fn pipeline_ticket_settled(ticket: &PipelineTicket) -> bool {
+    if ticket.outcome().is_some() {
+        return true;
+    }
+    if !ticket.compiled() {
+        return false;
+    }
+    let mut guard = lock_engine();
+    let EngineState {
+        ref owner,
+        ref mut caches,
+        ref mut pools,
+        ref counters,
+        ..
+    } = &mut *guard;
+    unsafe { caches.publish_compiled(owner.ctx.as_ref(), pools, counters) };
+    ticket.outcome().is_some()
+}
