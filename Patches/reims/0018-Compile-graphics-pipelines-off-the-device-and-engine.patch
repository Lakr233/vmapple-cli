+        }
+
+        fn exec_stamp(&self) -> u32 {
+            self.host.get_u32(self.stamp_gpa + 4)
+        }
+
+        fn sibling_stamp(&self) -> u32 {
+            self.host.get_u32(self.stamp_gpa + 8)
+        }
+
+        fn drain(&mut self) {
+            drain_pending(&mut self.state, &mut self.host);
+        }
+    }
