                 };
+                // A mipmapped heap texture's snapshot holds its base level. The
+                // levels above it are generated by halving, which is what the
+                // guest's own downsample kernel writes and this device cannot:
+                // a glass shader samples them for its blur, and level 0 alone
+                // blurs far less than a Mac does.
+                let mip_levels = texture_resource
+                    .as_ref()
+                    .filter(|_| {
+                        matches!(
+                            source,
+                            crate::backend::vulkan::engine::SampledSource::Bytes(_)
+                        ) && !arrayed
+                            && !volume
+                            && !cube
+                            && !one_dim
+                    })
+                    .and_then(|resource| heap_texture_of(&resource.descriptor))
+                    .map_or(1, |heap| {
+                        heap.mip_levels
+                            .min(32 - tw.max(th).max(1).leading_zeros())
+                            .max(1)
+                    });
+                if mip_levels > 1 {
+                    crate::runtime::drain::note_store_route("heap_sample_mipmapped");
+                }
                 images.push(crate::backend::vulkan::engine::SampledImageResource {
                     binding: img_bind,
                     array_element,
@@ -8551,6 +8577,7 @@ fn try_metal2vulkan_draw<M: HostMemory + HostOps>(
