diff --git a/crates/reims-vgpu/src/runtime/exec/tests.rs b/crates/reims-vgpu/src/runtime/exec/tests.rs
index cc5320666..2413a34f1 100644
--- a/crates/reims-vgpu/src/runtime/exec/tests.rs
+++ b/crates/reims-vgpu/src/runtime/exec/tests.rs
@@ -5008,3 +5008,78 @@ fn a_clear_seeds_the_pass_for_any_store_action_and_publishes_only_for_store() {
