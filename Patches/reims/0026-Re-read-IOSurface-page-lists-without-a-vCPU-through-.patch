+        const PAGE: u64 = 1 << 14;
+        let mut done = 0usize;
+        while done < buf.len() {
+            let at = kva + done as u64;
+            let Some(&gpa_page) = self.kva_cpu_pages.get(&(at & !(PAGE - 1))) else {
+                return Err(MemError::Unmapped);
