+            let at = kva + done as u64;
+            let page = host.kva_cpu_pages[&(at & !(G - 1))];
+            let n = ((G - (at & (G - 1))) as usize).min(bytes.len() - done);
+            host.write_gpa(page | (at & (G - 1)), &bytes[done..done + n])
