+pub const OBJECT_TYPE_TWIN_LAYOUT_TEXTURE: u8 = 12;
+/// Where the second copy of the level-0 layout sits in a type-12 descriptor.
+const TWIN_LAYOUT_COPY: std::ops::Range<usize> = 0x48..0x84;
