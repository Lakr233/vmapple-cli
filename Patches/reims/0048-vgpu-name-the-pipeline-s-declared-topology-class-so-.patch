From 44af93e56e49614a80196d19d2556417e43b082f Mon Sep 17 00:00:00 2001
From: Anees Iqbal <hello@aneesiqbal.ai>
Date: Sat, 29 Aug 2026 05:13:00 +0300
Subject: [PATCH 48/68] vgpu: name the pipeline's declared topology class, so
 112 pipelines stop being refused
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Component: crates/reims-vgpu/src/runtime/decode/resource — the type-7 render
pipeline descriptor's compact-TLV block.

A driven macos-15 boot refused 112 render pipelines — 92 distinct refs on one
task — every one as
`draw_load_pipeline fail reason=desc_decode decode=res_pipeline_field_unread`.
It was the largest loss class in the log by an order of magnitude, and a pipeline
that fails to load takes every draw that would have used it.

The cause was one unnamed field. The decoder refuses a descriptor carrying a tag
it cannot name rather than defaulting it, which is the right rule, and the
companion census line named the tag exactly:

  type7_pipeline reason=pipeline_descriptor_field_dropped kind=render
                 tag=0x0b len=4 first_value=0x3

Tag 0x0b is `MTLRenderPipelineDescriptor.inputPrimitiveTopology`. The tag
numbering is the serializer's own rather than a straight enumeration of the
descriptor's properties, so it was placed on three independent readings that
agree:

  - Position: it sits between PIPELINE_TAG_STENCIL_ATTACH_FORMAT (0x0a) and
    PIPELINE_TAG_MAX_TESSELLATION_FACTOR (0x0d), and inputPrimitiveTopology is
    the property MTLRenderPipeline.h declares between those two.
  - Value: the only value observed is 3, MTLPrimitiveTopologyClassTriangle.
    Every other candidate property in that span is a BOOL or a sample count and
    cannot be three.
  - Company: it appears on exactly one descriptor shape, the one that also
    carries the three tessellation tags — and Metal requires a tessellated
    pipeline to declare a topology class rather than leave it Unspecified.

It joins RENDER_PIPELINE_TAGS_BENIGN with its argument beside it, as that list
requires. It declares the *class* of primitive the pipeline is compiled for and
does not select one: every draw record carries its own MTLPrimitiveType, which
translate::raster::primitive_topology turns into the input-assembly topology, so
the class restates what the draw already names — the same relationship the two
attachment formats have with the pass descriptor. Metal requires a draw's
primitive type to belong to its pipeline's declared class, so the two cannot
disagree without the guest's own validation having rejected the draw first.

Verification: 2220 lib tests pass (+1 new, which fails without the change). It
decodes one descriptor at two topology classes and requires the same result, so
the value is asserted not to reach the decoded pipeline rather than merely to be
tolerated. clippy -D warnings exit 0 on all three arms.

Not verified: no boot yet with this change. The 112 refusals above are from the
boot that found it. Whether these pipelines then execute is a separate question
this does not answer — the shape they appear on is a tessellation pipeline, and
nothing here establishes that this device runs one; it establishes only that the
descriptor is no longer refused for carrying a field the contract defines. A
following boot should read draw_load_pipeline and the tessellation rails, not
just this counter.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../src/runtime/decode/resource/mod.rs        | 41 ++++++++++++++++++-
 .../src/runtime/decode/resource/tests.rs      | 30 ++++++++++++++
 2 files changed, 70 insertions(+), 1 deletion(-)

diff --git a/crates/reims-vgpu/src/runtime/decode/resource/mod.rs b/crates/reims-vgpu/src/runtime/decode/resource/mod.rs
index f1894b30f..033299f4f 100644
--- a/crates/reims-vgpu/src/runtime/decode/resource/mod.rs
+++ b/crates/reims-vgpu/src/runtime/decode/resource/mod.rs
@@ -1261,6 +1261,32 @@ pub const PIPELINE_TAG_DEPTH_ATTACH_FORMAT: u8 = 0x09;
 /// `MTLPixelFormat`. The stencil half of [`PIPELINE_TAG_DEPTH_ATTACH_FORMAT`],
 /// and benign for the same reason.
 pub const PIPELINE_TAG_STENCIL_ATTACH_FORMAT: u8 = 0x0a;
+/// `MTLRenderPipelineDescriptor.inputPrimitiveTopology`, an
+/// `MTLPrimitiveTopologyClass`.
+///
+/// The *class* of primitive the pipeline is compiled for — `Unspecified`,
+/// `Point`, `Line` or `Triangle` — and not a primitive type. See
+/// [`RENDER_PIPELINE_TAGS_BENIGN`] for why this device does not apply it.
+///
+/// # How it was placed
+///
+/// Three independent readings agree, which is worth recording because the tag
+/// numbering is the serializer's own and not a straight enumeration of the
+/// descriptor's properties:
+///
+/// * **Position.** It sits between [`PIPELINE_TAG_STENCIL_ATTACH_FORMAT`] and
+///   [`PIPELINE_TAG_MAX_TESSELLATION_FACTOR`], and `inputPrimitiveTopology` is
+///   the property the header declares between those two.
+/// * **Value.** The only value observed is `3`, which is
+///   `MTLPrimitiveTopologyClassTriangle`. Every other candidate property in that
+///   span is a `BOOL` or a sample count, and neither can be three.
+/// * **Company.** It appears on exactly one descriptor shape, the one that also
+///   carries [`PIPELINE_TAG_MAX_TESSELLATION_FACTOR`],
+///   [`PIPELINE_TAG_TESSELLATION_FACTOR_STEP_FUNCTION`] and
+///   [`PIPELINE_TAG_TESSELLATION_OUTPUT_WINDING_ORDER`] — and Metal requires a
+///   tessellated pipeline to declare a topology class rather than leave it
+///   `Unspecified`, which is why a tessellation pipeline is where it shows up.
+pub const PIPELINE_TAG_INPUT_PRIMITIVE_TOPOLOGY: u8 = 0x0b;
 /// `MTLRenderPipelineDescriptor.maxTessellationFactor`.
 pub const PIPELINE_TAG_MAX_TESSELLATION_FACTOR: u8 = 0x0d;
 /// `MTLRenderPipelineDescriptor.tessellationFactorStepFunction`.
@@ -2472,16 +2498,29 @@ pub const PIPELINE_TAG_COMPUTE_STAGE_INPUT_OFFSET: u8 = 0x03;
 ///   change what the guest observes; the attachment it observes is the one its
 ///   own pass named.
 ///
+/// * [`PIPELINE_TAG_INPUT_PRIMITIVE_TOPOLOGY`] declares the *class* of primitive
+///   the pipeline is compiled for. It does not select one: every draw record
+///   carries its own `MTLPrimitiveType`, which
+///   `translate::raster::primitive_topology` turns into the
+///   `VkPipelineInputAssemblyStateCreateInfo` topology, so the class restates
+///   what the draw already names — the same relationship the two attachment
+///   formats above have with the pass descriptor. Metal requires a draw's
+///   primitive type to belong to the class its pipeline declared, so the two
+///   cannot disagree without the guest's own validation having rejected the
+///   draw first. Dropping it cannot change what the guest observes; the topology
+///   it observes is the one its own draw named.
+///
 /// **`rasterizationEnabled` and `alphaToCoverageEnabled` are deliberately not
 /// here.** They are two of the three the old doc named as silently defaulted,
 /// and neither has appeared in this block on a driven boot. If one arrives it
 /// must refuse rather than be waved through. The third,
 /// [`PIPELINE_TAG_RASTER_SAMPLE_COUNT`], is now read — it is consumed on both
 /// shapes and carried to the backend render-pass and pipeline keys.
-const RENDER_PIPELINE_TAGS_BENIGN: [u8; 3] = [
+const RENDER_PIPELINE_TAGS_BENIGN: [u8; 4] = [
     RENDER_PIPELINE_TAG_LABEL,
     PIPELINE_TAG_DEPTH_ATTACH_FORMAT,
     PIPELINE_TAG_STENCIL_ATTACH_FORMAT,
+    PIPELINE_TAG_INPUT_PRIMITIVE_TOPOLOGY,
 ];
 /// The compute half of [`RENDER_PIPELINE_TAGS_BENIGN`]; same rule, and listed
 /// apart for the same reason `COMPUTE_PIPELINE_TAGS_CONSUMED` is.
diff --git a/crates/reims-vgpu/src/runtime/decode/resource/tests.rs b/crates/reims-vgpu/src/runtime/decode/resource/tests.rs
index 9c59f8435..1adb133fb 100644
--- a/crates/reims-vgpu/src/runtime/decode/resource/tests.rs
+++ b/crates/reims-vgpu/src/runtime/decode/resource/tests.rs
@@ -3171,3 +3171,33 @@ fn a_memoryless_texture_decodes_its_geometry_and_format() {
     assert_eq!(tex.sample_count, 1);
     assert!(decode_memoryless_texture_descriptor(&bytes[..20]).is_err());
 }
+
+#[test]
+fn a_declared_input_primitive_topology_does_not_refuse_the_pipeline() {
+    let decode_at = |topology: u32| {
+        let mut b = vec![0u8; 16 + 1 + 6 + 6];
+        let blen = b.len() as u32;
+        st32(&mut b[0..], TYPE7_OBJECT_RENDER_PIPELINE);
+        st32(&mut b[4..], blen);
+        st32(&mut b[8..], 9);
+        b[16] = 2;
+        b[17] = PIPELINE_TAG_VERTEX_FUNC;
+        b[18] = 4;
+        st32(&mut b[19..], 2);
+        b[23] = PIPELINE_TAG_INPUT_PRIMITIVE_TOPOLOGY;
+        b[24] = 4;
+        st32(&mut b[25..], topology);
+        decode_render_pipeline_descriptor(&b)
+    };
+
+    let triangle = decode_at(3).expect("a declared topology class is not a refusal");
+    let unspecified = decode_at(0).expect("nor is an unspecified one");
+    assert_eq!(
+        triangle, unspecified,
+        "the class must not reach the decoded pipeline: the topology a draw \
+         rasterizes at comes from its own primitive type"
+    );
+
+    assert!(RENDER_PIPELINE_TAGS_BENIGN.contains(&PIPELINE_TAG_INPUT_PRIMITIVE_TOPOLOGY));
+    assert!(!RENDER_PIPELINE_TAGS_BENIGN.contains(&0x6d));
+}
-- 
