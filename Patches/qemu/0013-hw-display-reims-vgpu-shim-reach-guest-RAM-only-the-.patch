+/**
+ * memory_no_dispatch_begin: start a section in which the calling thread may
+ * reach RAM only.
+ *
+ * Until the matching memory_no_dispatch_end(), an access through this API
+ * that would be dispatched to a device's MemoryRegionOps fails with
+ * MEMTX_ACCESS_ERROR instead, before the BQL is taken; RAM is read and
+ * written as usual. Sections nest. This is for code that runs without the
+ * BQL while holding a lock the BQL's holder may wait for, and must not cause
+ * device side effects: reading guest memory on a device's behalf, including
+ * the page-table reads of a debug address translation.
+ */
+void memory_no_dispatch_begin(void);
+
+/**
+ * memory_no_dispatch_end: end the section memory_no_dispatch_begin() began.
+ */
+void memory_no_dispatch_end(void);
+
+/**
+ * memory_dispatch_forbidden: whether the calling thread is in a section
+ * started by memory_no_dispatch_begin().
+ */
+bool memory_dispatch_forbidden(void);
+
