new file mode 100644
index 0000000000..33ea6161e9
--- /dev/null
+++ b/include/hw/display/reims-vgpu-ram.h
@@ -0,0 +1,118 @@
+/*
+ * reims-vgpu: copy to and from guest RAM, and only RAM.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Reims reads and writes guest memory from its drain worker and from vCPUs
+ * that run without the BQL, while holding its device lock. An access that
+ * reached a device would take the BQL there, the reverse of the main loop's
+ * order (BQL, then device lock), and would have the device's side effects.
+ * So every guest-memory callback copies through reims_vgpu_ram_copy():
+ *
+ * - each piece of the range must be ordinary, directly accessible RAM, and
+ *   writable RAM for a write; nothing is ever dispatched to a device;
+ * - a range that wraps past the top of the address space is refused;
+ * - the whole range is checked before any byte moves, so a write never
+ *   lands in the RAM half of a range whose other half is a device;
+ * - a refusal is an error, never a zero-filled success.
+ *
+ * QEMU's memory API comes in through the lookup, which keeps this testable
+ * on its own (tests/unit/test-reims-vgpu-ram.c).
+ */
+
+#ifndef HW_DISPLAY_REIMS_VGPU_RAM_H
+#define HW_DISPLAY_REIMS_VGPU_RAM_H
+
+/* One piece of a range: its host bytes, and what the lookup knows it by. */
+typedef struct ReimsVgpuRamPiece {
+    uint8_t *host;
+    uint64_t len;
+    void *region;
+    uint64_t offset;
+} ReimsVgpuRamPiece;
+
+/*
+ * Resolve the piece of guest memory that starts at @gpa, at most @want bytes
+ * of it. False when it is not ordinary RAM, or not writable RAM for a write.
+ * Must answer the same for the same arguments within one copy.
+ */
+typedef bool (*ReimsVgpuRamLookup)(void *opaque, uint64_t gpa, uint64_t want,
+                                   bool is_write, ReimsVgpuRamPiece *piece);
+
+/* Record that the first @piece->len bytes of @piece were written. */
+typedef void (*ReimsVgpuRamDirty)(void *opaque, const ReimsVgpuRamPiece *piece);
+
+enum {
+    REIMS_VGPU_RAM_OK = 0,
+    /* Some piece is not (writable) RAM. Nothing was copied. */
+    REIMS_VGPU_RAM_REFUSED = -1,
+    /* -2 is the callbacks' "no current CPU". */
+    /* The range wraps past the top of the address space, or has no buffer. */
+    REIMS_VGPU_RAM_BAD_RANGE = -3,
+};
+
+/* Walk [gpa, gpa + len): check every piece, or copy every piece. */
+static inline bool reims_vgpu_ram_walk(ReimsVgpuRamLookup lookup,
+                                       ReimsVgpuRamDirty dirty, void *opaque,
+                                       uint64_t gpa, uint8_t *buf, size_t len,
+                                       bool is_write, bool copy)
+{
+    uint64_t left = len;
+
+    while (left > 0) {
+        ReimsVgpuRamPiece piece;
+
+        if (!lookup(opaque, gpa, left, is_write, &piece) ||
+            !piece.host || piece.len == 0) {
+            return false;
+        }
+        if (piece.len > left) {
+            piece.len = left;
+        }
+        if (copy) {
+            if (is_write) {
+                memcpy(piece.host, buf, piece.len);
+                if (dirty) {
+                    dirty(opaque, &piece);
+                }
+            } else {
+                memcpy(buf, piece.host, piece.len);
+            }
+            buf += piece.len;
+        }
+        gpa += piece.len;
+        left -= piece.len;
+    }
+    return true;
+}
+
+/*
+ * Copy @len bytes between @buf and guest memory at @gpa: into guest memory
+ * when @is_write, out of it otherwise. Returns REIMS_VGPU_RAM_OK, or an error
+ * with nothing copied.
+ */
+static inline int reims_vgpu_ram_copy(ReimsVgpuRamLookup lookup,
+                                      ReimsVgpuRamDirty dirty, void *opaque,
+                                      uint64_t gpa, void *buf, size_t len,
+                                      bool is_write)
+{
+    if (len == 0) {
+        return REIMS_VGPU_RAM_OK;
+    }
+    if (!buf || (uint64_t)len - 1 > UINT64_MAX - gpa) {
+        return REIMS_VGPU_RAM_BAD_RANGE;
+    }
+    /* Every piece first: a refusal must leave guest memory as it was. */
+    if (!reims_vgpu_ram_walk(lookup, dirty, opaque, gpa, buf, len,
+                             is_write, false)) {
+        return REIMS_VGPU_RAM_REFUSED;
+    }
+    /* The lookup answers as it did a moment ago, so this cannot refuse. */
+    if (!reims_vgpu_ram_walk(lookup, dirty, opaque, gpa, buf, len,
+                             is_write, true)) {
+        return REIMS_VGPU_RAM_REFUSED;
+    }
+    return REIMS_VGPU_RAM_OK;
+}
+
+#endif
