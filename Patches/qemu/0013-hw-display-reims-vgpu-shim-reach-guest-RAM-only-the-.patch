diff --git a/tests/unit/test-reims-vgpu-ram.c b/tests/unit/test-reims-vgpu-ram.c
new file mode 100644
index 0000000000..ec96fe69a9
--- /dev/null
+++ b/tests/unit/test-reims-vgpu-ram.c
@@ -0,0 +1,261 @@
+/*
+ * reims-vgpu: the RAM-only guest-memory copy.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/display/reims-vgpu-ram.h"
+
+/*
+ * A small guest physical map: RAM at 0x1000, more RAM right after it at
+ * 0x2000 in another host buffer, a device at 0x3000, read-only RAM at 0x4000,
+ * and nothing anywhere else.
+ */
+typedef struct FakeMap {
+    uint8_t ram_a[0x1000];
+    uint8_t ram_b[0x1000];
+    uint8_t rom[0x1000];
+    unsigned lookups;
+    unsigned dirtied;
+    uint64_t dirty_bytes;
+} FakeMap;
+
+static bool fake_lookup(void *opaque, uint64_t gpa, uint64_t want,
+                        bool is_write, ReimsVgpuRamPiece *piece)
+{
+    FakeMap *m = opaque;
+    uint8_t *base;
+    uint64_t start;
+
+    m->lookups++;
+    if (gpa >= 0x1000 && gpa < 0x2000) {
+        base = m->ram_a;
+        start = 0x1000;
+    } else if (gpa >= 0x2000 && gpa < 0x3000) {
+        base = m->ram_b;
+        start = 0x2000;
+    } else if (gpa >= 0x4000 && gpa < 0x5000 && !is_write) {
+        base = m->rom;
+        start = 0x4000;
+    } else {
+        /* The device, read-only RAM for a write, or nothing. */
+        return false;
+    }
+    piece->host = base + (gpa - start);
+    piece->len = MIN(want, start + 0x1000 - gpa);
+    piece->region = m;
+    piece->offset = gpa;
+    return true;
+}
+
+static void fake_dirty(void *opaque, const ReimsVgpuRamPiece *piece)
+{
+    FakeMap *m = opaque;
+
+    m->dirtied++;
+    m->dirty_bytes += piece->len;
+}
+
+static int copy(FakeMap *m, uint64_t gpa, void *buf, size_t len, bool is_write)
+{
+    return reims_vgpu_ram_copy(fake_lookup, fake_dirty, m, gpa, buf, len,
+                               is_write);
+}
+
+static bool all_bytes(const uint8_t *p, size_t len, uint8_t value)
+{
+    for (size_t i = 0; i < len; i++) {
+        if (p[i] != value) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* A range over two RAM pieces is read and written whole, and marked dirty. */
+static void test_ram_across_pieces(void)
+{
+    g_autofree FakeMap *m = g_new0(FakeMap, 1);
+    uint8_t out[0x100], in[0x100];
+
+    memset(out, 0x5a, sizeof(out));
+    g_assert_cmpint(copy(m, 0x1f80, out, sizeof(out), true), ==,
+                    REIMS_VGPU_RAM_OK);
+    g_assert_true(all_bytes(m->ram_a + 0xf80, 0x80, 0x5a));
+    g_assert_true(all_bytes(m->ram_b, 0x80, 0x5a));
+    g_assert_cmpuint(m->dirtied, ==, 2);
+    g_assert_cmpuint(m->dirty_bytes, ==, sizeof(out));
+
+    g_assert_cmpint(copy(m, 0x1f80, in, sizeof(in), false), ==,
+                    REIMS_VGPU_RAM_OK);
+    g_assert_cmpmem(in, sizeof(in), out, sizeof(out));
+}
+
+/* A device is never read: an explicit error, and the buffer left alone. */
+static void test_device_read_refused(void)
+{
+    g_autofree FakeMap *m = g_new0(FakeMap, 1);
+    uint8_t buf[16];
+
+    memset(buf, 0xaa, sizeof(buf));
+    g_assert_cmpint(copy(m, 0x3000, buf, sizeof(buf), false), ==,
+                    REIMS_VGPU_RAM_REFUSED);
+    g_assert_true(all_bytes(buf, sizeof(buf), 0xaa));
+
+    /* Nor is the RAM in front of it, when the range runs on into it. */
+    memset(m->ram_b, 0x11, sizeof(m->ram_b));
+    g_assert_cmpint(copy(m, 0x2ff8, buf, sizeof(buf), false), ==,
+                    REIMS_VGPU_RAM_REFUSED);
+    g_assert_true(all_bytes(buf, sizeof(buf), 0xaa));
+}
+
+/*
+ * A write that runs from RAM into a device is refused before any byte is
+ * written: the RAM half is untouched and nothing is marked dirty.
+ */
+static void test_write_into_device_refused_first(void)
+{
+    g_autofree FakeMap *m = g_new0(FakeMap, 1);
+    uint8_t buf[0x100];
+
+    memset(buf, 0x55, sizeof(buf));
+    g_assert_cmpint(copy(m, 0x2f80, buf, sizeof(buf), true), ==,
+                    REIMS_VGPU_RAM_REFUSED);
+    g_assert_true(all_bytes(m->ram_b, sizeof(m->ram_b), 0));
+    g_assert_cmpuint(m->dirtied, ==, 0);
+}
+
+/* Read-only RAM reads, and refuses a write whole. */
+static void test_read_only_ram(void)
+{
+    g_autofree FakeMap *m = g_new0(FakeMap, 1);
+    uint8_t buf[8];
+
+    memset(m->rom, 0x33, sizeof(m->rom));
+    g_assert_cmpint(copy(m, 0x4000, buf, sizeof(buf), false), ==,
+                    REIMS_VGPU_RAM_OK);
+    g_assert_true(all_bytes(buf, sizeof(buf), 0x33));
+
+    memset(buf, 0x77, sizeof(buf));
+    g_assert_cmpint(copy(m, 0x4000, buf, sizeof(buf), true), ==,
+                    REIMS_VGPU_RAM_REFUSED);
+    g_assert_true(all_bytes(m->rom, sizeof(m->rom), 0x33));
+}
+
+/* A range past the top of the address space is refused before any lookup. */
+static void test_bad_ranges(void)
+{
+    g_autofree FakeMap *m = g_new0(FakeMap, 1);
+    uint8_t buf[16];
+
+    g_assert_cmpint(copy(m, UINT64_MAX - 7, buf, sizeof(buf), false), ==,
+                    REIMS_VGPU_RAM_BAD_RANGE);
+    g_assert_cmpint(copy(m, UINT64_MAX - 7, buf, sizeof(buf), true), ==,
+                    REIMS_VGPU_RAM_BAD_RANGE);
+    g_assert_cmpint(copy(m, 0x1000, NULL, 4, false), ==,
+                    REIMS_VGPU_RAM_BAD_RANGE);
+    g_assert_cmpuint(m->lookups, ==, 0);
+
+    /* Ending exactly at the top does not wrap; it is simply not RAM. */
+    g_assert_cmpint(copy(m, UINT64_MAX - 15, buf, sizeof(buf), false), ==,
+                    REIMS_VGPU_RAM_REFUSED);
+    g_assert_cmpint(copy(m, 0x1000, buf, 0, true), ==, REIMS_VGPU_RAM_OK);
+}
+
+/*
+ * The deadlock this exists to prevent. The main loop holds the BQL and
+ * waits for the device lock; the drain worker holds the device lock and
+ * reads guest memory at an address that is a device. The read must fail
+ * without needing the BQL, so the worker can let go of the device lock.
+ */
+typedef struct LockPair {
+    GMutex bql;
+    GMutex device;
+    GMutex state_lock;
+    GCond state_cond;
+    bool main_loop_has_bql;
+    bool main_loop_done;
+} LockPair;
+
+static gpointer main_loop(gpointer opaque)
+{
+    LockPair *p = opaque;
+
+    g_mutex_lock(&p->bql);
+    g_mutex_lock(&p->state_lock);
+    p->main_loop_has_bql = true;
+    g_cond_broadcast(&p->state_cond);
+    g_mutex_unlock(&p->state_lock);
+
+    g_mutex_lock(&p->device);
+    g_mutex_unlock(&p->device);
+    g_mutex_unlock(&p->bql);
+
+    g_mutex_lock(&p->state_lock);
+    p->main_loop_done = true;
+    g_cond_broadcast(&p->state_cond);
+    g_mutex_unlock(&p->state_lock);
+    return NULL;
+}
+
+static void test_no_bql_while_device_lock_held(void)
+{
+    g_autofree FakeMap *m = g_new0(FakeMap, 1);
+    LockPair p = { 0 };
+    GThread *thread;
+    uint8_t buf[16];
+    gint64 deadline;
+
+    memset(buf, 0, sizeof(buf));
+    g_mutex_init(&p.bql);
+    g_mutex_init(&p.device);
+    g_mutex_init(&p.state_lock);
+    g_cond_init(&p.state_cond);
+
+    g_mutex_lock(&p.device);
+    thread = g_thread_new("main-loop", main_loop, &p);
+    g_mutex_lock(&p.state_lock);
+    while (!p.main_loop_has_bql) {
+        g_cond_wait(&p.state_cond, &p.state_lock);
+    }
+    g_mutex_unlock(&p.state_lock);
+
+    g_assert_cmpint(copy(m, 0x3000, buf, sizeof(buf), false), ==,
+                    REIMS_VGPU_RAM_REFUSED);
+    g_assert_cmpint(copy(m, 0x2ff8, buf, sizeof(buf), true), ==,
+                    REIMS_VGPU_RAM_REFUSED);
+    /* The main loop still holds the BQL: the worker never needed it. */
+    g_assert_false(g_mutex_trylock(&p.bql));
+    g_mutex_unlock(&p.device);
+
+    deadline = g_get_monotonic_time() + 5 * G_TIME_SPAN_SECOND;
+    g_mutex_lock(&p.state_lock);
+    while (!p.main_loop_done) {
+        g_assert_true(g_cond_wait_until(&p.state_cond, &p.state_lock,
+                                        deadline));
+    }
+    g_mutex_unlock(&p.state_lock);
+    g_thread_join(thread);
+
+    g_cond_clear(&p.state_cond);
+    g_mutex_clear(&p.state_lock);
+    g_mutex_clear(&p.device);
+    g_mutex_clear(&p.bql);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/reims-vgpu-ram/ram-across-pieces", test_ram_across_pieces);
+    g_test_add_func("/reims-vgpu-ram/device-read-refused",
+                    test_device_read_refused);
+    g_test_add_func("/reims-vgpu-ram/write-into-device-refused-first",
+                    test_write_into_device_refused_first);
+    g_test_add_func("/reims-vgpu-ram/read-only-ram", test_read_only_ram);
+    g_test_add_func("/reims-vgpu-ram/bad-ranges", test_bad_ranges);
+    g_test_add_func("/reims-vgpu-ram/no-bql-while-device-lock-held",
+                    test_no_bql_while_device_lock_held);
+    return g_test_run();
+}
