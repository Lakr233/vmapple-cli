+/// What [`type_def_of`] finds for every id, gathered in one pass for a scan that leaves the globals
+/// alone. The first definition of an id wins, as in [`type_def_of`].
+pub(in crate::passes) struct GlobalDefs<'a>(HashMap<Word, &'a Instruction>);
+
+impl<'a> GlobalDefs<'a> {
+    pub(in crate::passes) fn new(ctx: &'a Ctx) -> Self {
+        let mut defs = HashMap::new();
+        for inst in ctx
+            .new_globals
+            .iter()
+            .chain(ctx.module.types_global_values.iter())
+        {
+            if let Some(id) = inst.result_id {
+                defs.entry(id).or_insert(inst);
+            }
+        }
+        Self(defs)
+    }
+
+    pub(in crate::passes) fn get(&self, ty: Word) -> Option<&'a Instruction> {
+        self.0.get(&ty).copied()
+    }
+}
+
+/// What [`value_result_type`] finds for every id, gathered in one pass for a scan that leaves the
+/// module alone. The first definition of an id wins, as in [`value_result_type`].
+pub(in crate::passes) struct ValueTypes(HashMap<Word, Option<Word>>);
+
+impl ValueTypes {
+    pub(in crate::passes) fn new(ctx: &Ctx) -> Self {
+        let mut types = HashMap::new();
+        let functions = ctx.module.functions.iter().flat_map(|f| {
+            f.parameters
+                .iter()
+                .chain(f.blocks.iter().flat_map(|block| block.instructions.iter()))
+        });
+        for inst in ctx
+            .new_globals
+            .iter()
+            .chain(ctx.module.types_global_values.iter())
+            .chain(functions)
+        {
+            if let Some(id) = inst.result_id {
+                types.entry(id).or_insert(inst.result_type);
+            }
+        }
+        Self(types)
+    }
+
+    pub(in crate::passes) fn get(&self, v: Word) -> Option<Word> {
+        self.0.get(&v).copied().flatten()
+    }
+}
