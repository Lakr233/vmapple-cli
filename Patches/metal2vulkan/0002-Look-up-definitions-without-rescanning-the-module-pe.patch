+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::spirv_module::{Block, Function};
+
+    fn copy(id: Word, source: Word) -> Instruction {
+        Instruction::new(
+            Op::CopyObject,
+            Some(1),
+            Some(id),
+            vec![Operand::IdRef(source)],
+        )
+    }
+
+    fn module_with(blocks: Vec<Vec<Instruction>>) -> Module {
+        let mut module = Module::new();
+        let mut function = Function::new();
+        function.blocks = blocks
+            .into_iter()
+            .map(|instructions| Block {
+                label: None,
+                instructions,
+            })
+            .collect();
+        module.functions.push(function);
+        module
+    }
+
+    #[test]
+    fn chain_definitions_follow_the_rewrites_and_answer_like_the_scan() {
+        let mut module = module_with(vec![vec![copy(10, 2)], vec![copy(11, 10)]]);
+        let mut definitions = ChainDefinitions::new(&module);
+        assert_eq!(definitions.find(&module, 11), Some(&copy(11, 10)));
+        assert_eq!(definitions.find(&module, 12), None);
+
+        let old = module.functions[0].blocks[1].instructions[0].clone();
+        let prefix = vec![copy(12, 2)];
+        let new = copy(13, 12);
+        definitions.splice(&old, &prefix, &new);
+        module.functions[0].blocks[1].instructions = vec![prefix[0].clone(), new.clone()];
+        assert_eq!(definitions.find(&module, 11), None);
+        assert_eq!(definitions.find(&module, 12), Some(&prefix[0]));
+        assert_eq!(definitions.find(&module, 13), Some(&new));
+    }
+
+    #[test]
+    fn chain_definitions_scan_once_an_id_is_defined_twice() {
+        let first = copy(10, 2);
+        let second = copy(10, 3);
+        let module = module_with(vec![vec![first.clone()], vec![second]]);
+        let definitions = ChainDefinitions::new(&module);
+        assert!(definitions.0.is_none());
+        assert_eq!(definitions.find(&module, 10), Some(&first));
+    }
+}
