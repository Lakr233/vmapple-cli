+/// The entry [`type_defs_with_new_globals`] would hold for `id`, found without building the map:
+/// a synthesized global wins over the module's, and a later definition over an earlier one.
+fn type_def_with_new_globals(ctx: &Ctx, id: Word) -> Option<&Instruction> {
+    ctx.new_globals
+        .iter()
+        .rev()
+        .chain(ctx.module.types_global_values.iter().rev())
+        .find(|inst| inst.result_id == Some(id))
+}
