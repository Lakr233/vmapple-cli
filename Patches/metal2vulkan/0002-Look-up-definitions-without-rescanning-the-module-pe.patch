+/// The defining instruction of each id in the module's function bodies, kept in step with the
+/// changes [`rewrite_raw_word_alias_chains`] makes, so [`exact_raw_word_fact`] can look a pointer's
+/// definition up instead of scanning every function for it.
+///
+/// The scan answers with the first definition in module order. While every id has one definition
+/// that is the only one, so the map answers the same; at the first id defined twice the map is
+/// dropped and every later lookup scans again.
+pub(in crate::passes) struct ChainDefinitions(Option<HashMap<Word, Instruction>>);
+
+impl ChainDefinitions {
+    fn new(module: &Module) -> Self {
+        let mut definitions = Self(Some(HashMap::new()));
+        for inst in module
+            .functions
+            .iter()
+            .flat_map(|function| &function.blocks)
+            .flat_map(|block| &block.instructions)
+        {
+            definitions.insert(inst);
+        }
+        definitions
+    }
+
+    fn insert(&mut self, inst: &Instruction) {
+        let (Some(definitions), Some(id)) = (&mut self.0, inst.result_id) else {
+            return;
+        };
+        if definitions.insert(id, inst.clone()).is_some() {
+            self.0 = None;
+        }
+    }
+
+    /// `old` was replaced in place by `new`.
+    fn replace(&mut self, old: &Instruction, new: &Instruction) {
+        if let (Some(definitions), Some(id)) = (&mut self.0, old.result_id) {
+            definitions.remove(&id);
+        }
+        self.insert(new);
+    }
+
+    /// `prefix` was inserted before `old`, and `old` was replaced by `new`.
+    fn splice(&mut self, old: &Instruction, prefix: &[Instruction], new: &Instruction) {
+        for inst in prefix {
+            self.insert(inst);
+        }
+        self.replace(old, new);
+    }
+
+    fn find<'a>(&'a self, module: &'a Module, id: Word) -> Option<&'a Instruction> {
+        let scan = || {
+            module.functions.iter().find_map(|function| {
+                function
+                    .blocks
+                    .iter()
+                    .flat_map(|block| &block.instructions)
+                    .find(|instruction| instruction.result_id == Some(id))
+            })
+        };
+        match &self.0 {
+            Some(definitions) => {
+                let found = definitions.get(&id);
+                debug_assert_eq!(found, scan(), "stale definition of %{id}");
+                found
+            }
+            None => scan(),
+        }
+    }
+}
