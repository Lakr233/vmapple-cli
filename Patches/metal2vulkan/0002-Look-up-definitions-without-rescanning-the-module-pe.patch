+/// A labeled block's first `OpSelectionMerge`.
+struct LabeledSelection {
+    block_idx: usize,
+    block_label: Word,
+    selection_merge_idx: usize,
+}
+
+/// Labeled blocks with a selection merge, keyed by merge target, each list in block order.
+fn labeled_selections_by_merge(blocks: &[Block]) -> HashMap<Word, Vec<LabeledSelection>> {
+    let mut selections = HashMap::<Word, Vec<LabeledSelection>>::new();
+    for (block_idx, block) in blocks.iter().enumerate() {
+        let Some(block_label) = block.label.as_ref().and_then(|label| label.result_id) else {
+            continue;
+        };
+        let Some(selection_merge_idx) = block
+            .instructions
+            .iter()
+            .position(|inst| inst.class.opcode == Op::SelectionMerge)
+        else {
+            continue;
+        };
+        let Some(merge) = block.instructions[selection_merge_idx]
+            .operands
+            .first()
+            .and_then(id_ref_operand)
+        else {
+            continue;
+        };
+        selections.entry(merge).or_default().push(LabeledSelection {
+            block_idx,
+            block_label,
+            selection_merge_idx,
+        });
+    }
+    selections
 }
 
