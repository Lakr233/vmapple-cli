+/// Translate, then retry once with every internal helper inlined when the result still reads a zero
+/// Private variable it never writes.
+///
+/// Such a variable is the emitter's stand-in for a pointer it lost across a helper call, and the
+/// module validates with it, so none of the validation-driven tiers below sees the problem. Inlined,
+/// the pointer and its uses share one body and the aggregate fold forwards it. The retry is adopted
+/// only when it translates and reads strictly fewer such variables; every other module keeps the
+/// bytes the first translation produced. See [`unwritten_private`].
 fn translate_sanitized_with_meta(
     san_ll: &str,
     stage: passes::Stage,
@@ -924,6 +933,47 @@ fn translate_sanitized_with_meta(
     tmp: &Path,
     options: passes::TransformOptions,
     psb_retry_enabled: bool,
+) -> Result<Vec<u8>, String> {
+    let translate = |san_ll: &str| {
+        translate_sanitized_with_meta_once(
+            san_ll,
+            stage,
+            frag,
+            vert,
+            kern,
+            promoted_kern,
+            entry_name,
+            tmp,
+            options,
+            psb_retry_enabled,
+        )
+    };
+    let spv = translate(san_ll)?;
+    let unwritten = unwritten_private::unwritten_private_reads(&spv);
+    if unwritten == 0 {
+        return Ok(spv);
+    }
+    let inlined = native::inline_and_fold_aggregates(san_ll);
+    if inlined == san_ll {
+        return Ok(spv);
+    }
+    match translate(&inlined) {
+        Ok(retry) if unwritten_private::unwritten_private_reads(&retry) < unwritten => Ok(retry),
+        _ => Ok(spv),
+    }
+}
