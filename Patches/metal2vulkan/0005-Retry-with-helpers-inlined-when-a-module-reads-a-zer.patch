--- /dev/null
+++ b/src/unwritten_private.rs
@@ -0,0 +1,153 @@
+//! Count the zero Private variables a translated module reads but never writes.
+//!
+//! When the emitter cannot trace a pointer, it stands in a Private variable initialised to
+//! `OpConstantNull` (see `emit_private_zero_pointer_value_at`). The module still validates, so no
+//! retry tier fires, but every load through that pointer reads zero. A pointer the emitter loses
+//! this way usually crosses a helper call: an argument-buffer pointer returned inside Core Image's
+//! `coreimage::Sampler_h`, or the offset table CoreAnimation's `narrow_blur_19_sample` receives as
+//! a parameter. Those kernels then sample at (0, 0) or with zero offsets.
+//!
+//! The count walks the binary's words, so it needs no parse of the module: a variable is the root
+//! of every access chain, copy and bitcast taken from it, and it counts when some `OpLoad` or
+//! `OpCopyMemory` reads through it and no `OpStore` or `OpCopyMemory` writes through it.
+
+use std::collections::{HashMap, HashSet};
+
+const OP_CONSTANT_NULL: u32 = 46;
+const OP_VARIABLE: u32 = 59;
+const OP_LOAD: u32 = 61;
+const OP_STORE: u32 = 62;
+const OP_COPY_MEMORY: u32 = 63;
+const OP_ACCESS_CHAIN: u32 = 65;
+const OP_IN_BOUNDS_ACCESS_CHAIN: u32 = 66;
+const OP_PTR_ACCESS_CHAIN: u32 = 67;
+const OP_IN_BOUNDS_PTR_ACCESS_CHAIN: u32 = 70;
+const OP_COPY_OBJECT: u32 = 83;
+const OP_BITCAST: u32 = 124;
+const STORAGE_CLASS_PRIVATE: u32 = 6;
+const HEADER_WORDS: usize = 5;
+
+/// How many zero-initialised Private variables `spv` reads and never writes. Zero for bytes that are
+/// not a little-endian SPIR-V module.
+pub(crate) fn unwritten_private_reads(spv: &[u8]) -> usize {
+    if !spv.len().is_multiple_of(4) {
+        return 0;
+    }
+    let words: Vec<u32> = spv
+        .chunks_exact(4)
+        .map(|word| u32::from_le_bytes([word[0], word[1], word[2], word[3]]))
+        .collect();
+    if words.first() != Some(&spirv::MAGIC_NUMBER) || words.len() < HEADER_WORDS {
+        return 0;
+    }
+    let mut nulls = HashSet::new();
+    let mut root: HashMap<u32, u32> = HashMap::new();
+    let mut read = HashSet::new();
+    let mut written = HashSet::new();
+    let mut at = HEADER_WORDS;
+    while at < words.len() {
+        let count = (words[at] >> 16) as usize;
+        if count == 0 || at + count > words.len() {
+            return 0;
+        }
+        let operands = &words[at + 1..at + count];
+        match words[at] & 0xffff {
+            OP_CONSTANT_NULL if operands.len() >= 2 => {
+                nulls.insert(operands[1]);
+            }
+            OP_VARIABLE if operands.len() >= 4 => {
+                if operands[2] == STORAGE_CLASS_PRIVATE && nulls.contains(&operands[3]) {
+                    root.insert(operands[1], operands[1]);
+                }
+            }
+            OP_ACCESS_CHAIN
+            | OP_IN_BOUNDS_ACCESS_CHAIN
+            | OP_PTR_ACCESS_CHAIN
+            | OP_IN_BOUNDS_PTR_ACCESS_CHAIN
+            | OP_COPY_OBJECT
+            | OP_BITCAST
+                if operands.len() >= 3 =>
+            {
+                if let Some(&variable) = root.get(&operands[2]) {
+                    root.insert(operands[1], variable);
+                }
+            }
+            OP_LOAD if operands.len() >= 3 => {
+                if let Some(&variable) = root.get(&operands[2]) {
+                    read.insert(variable);
+                }
+            }
+            OP_STORE if !operands.is_empty() => {
+                if let Some(&variable) = root.get(&operands[0]) {
+                    written.insert(variable);
+                }
+            }
+            OP_COPY_MEMORY if operands.len() >= 2 => {
+                if let Some(&variable) = root.get(&operands[0]) {
+                    written.insert(variable);
+                }
+                if let Some(&variable) = root.get(&operands[1]) {
+                    read.insert(variable);
+                }
+            }
+            _ => {}
+        }
+        at += count;
+    }
+    read.difference(&written).count()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::unwritten_private_reads;
+
+    fn module(body: &[&[u32]]) -> Vec<u8> {
+        let mut words = vec![spirv::MAGIC_NUMBER, 0x0001_0400, 0, 100, 0];
+        for instruction in body {
+            words.push(((instruction.len() as u32) << 16) | instruction[0]);
+            words.extend_from_slice(&instruction[1..]);
+        }
+        words.iter().flat_map(|word| word.to_le_bytes()).collect()
+    }
+
+    // %1 float, %2 pointer type, %3 null, %4 Private variable initialised to %3.
+    const NULL: &[u32] = &[46, 1, 3];
+    const VARIABLE: &[u32] = &[59, 2, 4, 6, 3];
+
+    #[test]
+    fn a_load_through_a_copy_of_an_unwritten_zero_variable_counts() {
+        let copy: &[u32] = &[83, 2, 5, 4];
+        let load: &[u32] = &[61, 1, 6, 5];
+        assert_eq!(
+            unwritten_private_reads(&module(&[NULL, VARIABLE, copy, load])),
+            1
+        );
+    }
+
+    #[test]
+    fn a_variable_written_through_an_access_chain_does_not_count() {
+        let chain: &[u32] = &[66, 2, 5, 4, 7];
+        let store: &[u32] = &[62, 5, 8];
+        let load: &[u32] = &[61, 1, 6, 4];
+        assert_eq!(
+            unwritten_private_reads(&module(&[NULL, VARIABLE, chain, store, load])),
+            0
+        );
+    }
+
+    #[test]
+    fn a_function_variable_does_not_count() {
+        let function_variable: &[u32] = &[59, 2, 4, 7, 3];
+        let load: &[u32] = &[61, 1, 6, 4];
+        assert_eq!(
+            unwritten_private_reads(&module(&[NULL, function_variable, load])),
+            0
+        );
+    }
+
+    #[test]
+    fn bytes_that_are_not_spir_v_count_nothing() {
+        assert_eq!(unwritten_private_reads(&[1, 2, 3]), 0);
+        assert_eq!(unwritten_private_reads(&[0; 8]), 0);
+    }
+}
