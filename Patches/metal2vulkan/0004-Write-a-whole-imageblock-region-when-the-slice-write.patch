+/// CoreAnimation's blur kernels fill a shared imageblock tile, meet at a barrier and have one thread
+/// write the whole tile. The write names the origin cell and an explicit 32x32 region, so it must
+/// walk every cell of the region rather than store the calling thread's one cell.
+#[test]
+fn native_kernel_imageblock_region_write_walks_the_whole_region() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.3"
+%"struct.metal::_imageblock_base" = type { ptr addrspace(4) }
+
+define void @k(%"struct.metal::_imageblock_base" %img_blk, ptr addrspace(1) %dst, <2 x i16> %tg, <2 x i16> %tid) {
+entry:
+  %cell = tail call ptr addrspace(4) @air.imageblock_data(<2 x i16> %tid, i32 0, i16 0)
+  store <4 x half> <half 0xH3C00, half 0xH3C00, half 0xH3C00, half 0xH3C00>, ptr addrspace(4) %cell, align 8
+  call void @air.wg.barrier(i32 8, i32 1)
+  %x = extractelement <2 x i16> %tid, i64 0
+  %y = extractelement <2 x i16> %tid, i64 1
+  %xy = or i16 %x, %y
+  %first = icmp eq i16 %xy, 0
+  br i1 %first, label %write, label %done
+
+write:
+  %origin = tail call ptr addrspace(4) @air.imageblock_data(<2 x i16> zeroinitializer, i32 0, i16 0)
+  %base = shl <2 x i16> %tg, <i16 5, i16 5>
+  tail call void @air.write_imageblock_slice_to_texture_2d.i16.v4f16(ptr addrspace(1) %dst, ptr addrspace(4) %origin, i1 true, <2 x i16> zeroinitializer, <2 x i16> <i16 32, i16 32>, <2 x i16> %base, i16 0, i1 false, i32 2)
+  br label %done
+
+done:
+  ret void
+}
+
+declare ptr addrspace(4) @air.imageblock_data(<2 x i16>, i32, i16)
+declare void @air.write_imageblock_slice_to_texture_2d.i16.v4f16(ptr addrspace(1), ptr addrspace(4), i1, <2 x i16>, <2 x i16>, <2 x i16>, i16, i1, i32)
+declare void @air.wg.barrier(i32, i32)
+
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3, !5, !6, !7}
+!3 = !{i32 0, !"air.imageblock", !"explicit", !"air.imageblock_data_size", i32 8, !"air.struct_type_info", !4, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"imageblock<ImageBlockData, layout_explicit>", !"air.arg_name", !"imgBlk"}
+!4 = !{i32 0, i32 8, i32 0, !"half4", !"v"}
+!5 = !{i32 1, !"air.texture", !"air.location_index", i32 1, i32 1, !"air.write", !"air.arg_type_name", !"texture2d<half, write>", !"air.arg_name", !"dst"}
+!6 = !{i32 2, !"air.threadgroup_position_in_grid", !"air.arg_type_name", !"ushort2", !"air.arg_name", !"tg"}
+!7 = !{i32 3, !"air.thread_position_in_threadgroup", !"air.arg_type_name", !"ushort2", !"air.arg_name", !"tid"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_kernel_imageblock_region_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_sanitized_native(ll, Stage::Kernel, &tmp).expect("translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    assert!(asm.contains("OpFunctionCall"), "{asm}");
+    assert!(asm.contains("OpLoopMerge"), "{asm}");
+    assert!(asm.contains("OpImageWrite"), "{asm}");
+    assert!(
+        asm.lines()
+            .any(|line| line.contains("OpVariable") && line.contains("Workgroup")),
+        "the tile must be shared between the threads that fill it and the one that writes it\n{asm}"
+    );
+    assert!(!asm.contains("air.imageblock"), "{asm}");
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&spv, &tmp).expect("spirv-val");
+    }
+    let _ = std::fs::remove_dir_all(tmp);
+}
