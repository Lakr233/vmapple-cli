+/// Stack for the thread that builds the construct-tree candidate alongside the large-CFG feed: at
+/// least what a process main thread gets, since that is where the CLI runs the sequential path.
+const SPECULATIVE_STACK_BYTES: usize = 16 << 20;
+
 fn translate_sanitized_with_meta(
     san_ll: &str,
     stage: passes::Stage,
@@ -943,10 +947,51 @@ fn translate_sanitized_with_meta(
     // select later retries. Count structural LLVM blocks without parsing instruction bodies.
     let max_function_blocks = sanitized_max_function_basic_block_count(san_ll);
     if large_cfg_relooper_eligible(max_function_blocks) {
-        if let Some(relooped) = rc.raw_feed_then_relooper() {
+        // The construct tree is tried only after the feed fails in a way it can fix, but what it
+        // builds does not depend on the feed. Build it on a second thread while the feed runs, and
+        // stop it at its next phase boundary if the feed's outcome says it is not needed.
+        let cancel = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let (relooped, speculative) = std::thread::scope(|scope| {
+            let speculative = std::thread::Builder::new()
+                .name("m2v-construct-tree".into())
+                .stack_size(SPECULATIVE_STACK_BYTES)
+                .spawn_scoped(scope, {
+                    let cancel = cancel.clone();
+                    move || {
+                        retry::speculate(cancel, || {
+                            retry::RetryCtx::new(
+                                san_ll,
+                                stage,
+                                frag,
+                                vert,
+                                kern,
+                                promoted_kern,
+                                entry_name,
+                                tmp,
+                                options,
+                                psb_retry_enabled,
+                            )
+                            .construct_tree_retry()
+                        })
+                    }
+                });
+            let relooped = rc.raw_feed_then_relooper();
+            if relooped.is_some() || !rc.large_cfg_construct_tree_eligible() {
+                cancel.store(true, std::sync::atomic::Ordering::Relaxed);
+            }
+            let speculative = speculative.map(|handle| handle.join());
+            (relooped, speculative)
+        });
+        if let Some(relooped) = relooped {
             return Ok(relooped);
         }
         if rc.large_cfg_construct_tree_eligible() {
+            // Never cancelled on this path, so its verdict is the one the sequential call reaches.
+            match speculative {
+                Ok(Ok(verdict)) => rc.remember_construct_tree_verdict(verdict),
+                Ok(Err(panic)) => std::panic::resume_unwind(panic),
+                Err(_) => {}
+            }
             if let Some(constructed) = rc.construct_tree_retry() {
                 return Ok(constructed);
             }
