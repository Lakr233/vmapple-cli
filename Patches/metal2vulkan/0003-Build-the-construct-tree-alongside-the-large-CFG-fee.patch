diff --git a/src/retry.rs b/src/retry.rs
index 2a9533f..718a21e 100644
--- a/src/retry.rs
+++ b/src/retry.rs
@@ -23,8 +23,41 @@ use crate::{
     finish_module, meta, native, passes, stage_buffer_layouts, tools, FinishRewrites,
     FinishedModule,
 };
+use std::cell::RefCell;
 use std::collections::HashMap;
 use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+
+thread_local! {
+    /// Set on a thread building a candidate that may turn out not to be needed; see
+    /// [`speculate`].
+    static SPECULATION_CANCEL: RefCell<Option<Arc<AtomicBool>>> = const { RefCell::new(None) };
+}
+
+/// Run `work` on this thread so that [`speculation_cancelled`] answers from `cancel`.
+///
+/// A speculative candidate is only ever adopted when nobody cancelled it, so a cancelled one may
+/// stop early with any refusal: whatever it returns is discarded.
+pub(crate) fn speculate<T>(cancel: Arc<AtomicBool>, work: impl FnOnce() -> T) -> T {
+    SPECULATION_CANCEL.with(|slot| *slot.borrow_mut() = Some(cancel));
+    let result = work();
+    SPECULATION_CANCEL.with(|slot| *slot.borrow_mut() = None);
+    result
+}
+
+/// Whether this thread's speculative candidate is no longer wanted. Always false on a thread that
+/// is not running [`speculate`].
+pub(crate) fn speculation_cancelled() -> bool {
+    SPECULATION_CANCEL.with(|slot| {
+        slot.borrow()
+            .as_ref()
+            .is_some_and(|cancel| cancel.load(Ordering::Relaxed))
+    })
+}
+
+/// The refusal a cancelled speculative candidate stops with.
+pub(crate) const SPECULATION_CANCELLED: &str = "speculative candidate no longer needed";
 
